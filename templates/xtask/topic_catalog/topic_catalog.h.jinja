#ifdef __cplusplus
extern "C" {
#endif

#define SYNAPSE_CMD_KEY_PREFIX {{ cmd_key_prefix|tojson }}
#define SYNAPSE_META_KEY_PREFIX {{ meta_key_prefix|tojson }}
#define SYNAPSE_LIVELINESS_KEY_PREFIX {{ liveliness_key_prefix|tojson }}
#define SYNAPSE_SCHEMA_SET_HASH {{ schema_set_hash|tojson }}
#define SYNAPSE_MCAP_PROFILE {{ mcap_profile|tojson }}
#define SYNAPSE_MCAP_SCHEMA_ENCODING {{ mcap_schema_encoding|tojson }}
#define SYNAPSE_MCAP_MESSAGE_ENCODING {{ mcap_message_encoding|tojson }}
#define SYNAPSE_MCAP_METADATA_NAME {{ mcap_metadata_name|tojson }}
#define SYNAPSE_MCAP_SCHEMA_SET_HASH_KEY {{ mcap_schema_set_hash_key|tojson }}
#define SYNAPSE_MCAP_SESSION_ID_KEY {{ mcap_session_id_key|tojson }}
#define SYNAPSE_MCAP_SOURCE_KEY {{ mcap_source_key|tojson }}
#define SYNAPSE_MCAP_TIME_BASIS_KEY {{ mcap_time_basis_key|tojson }}
#define SYNAPSE_MCAP_TIME_BASIS_MONOTONIC_BOOT {{ mcap_time_basis_monotonic_boot|tojson }}
#define SYNAPSE_MCAP_TIME_BASIS_UNIX_EPOCH {{ mcap_time_basis_unix_epoch|tojson }}
#define SYNAPSE_MCAP_TIME_BASIS_CORRELATED {{ mcap_time_basis_correlated|tojson }}
#define SYNAPSE_MCAP_TOPIC_ID_KEY {{ mcap_topic_id_key|tojson }}

typedef struct synapse_topic_info {
    uint16_t id;
    const char *name;
    const char *key; /* canonical short key: [<namespace>/]<key>[/<instance>] */
    const char *root_table;
    const char *payload_type;
    size_t payload_size; /* zero when the topic has no fixed-layout payload */
    const char *schema_file;
    const char *mcap_schema_name; /* fully qualified MCAP Schema.name */
    const char *mcap_schema_file; /* package-relative BFBS */
    const char *wire_type; /* fully qualified FlatBuffers value type */
    const char *schema_hash; /* SHA-256 of the transitive wire schema */
    bool fixed_layout;
    bool multi_instance;
    const char *scope;
    const char *encoding;
    const char *description;
} synapse_topic_info_t;

typedef struct synapse_command_info {
    uint16_t id; /* mirrors synapse.cmd.CmdId */
    const char *name;
    const char *key;
    const char *request_type; /* fully qualified FlatBuffers type */
    const char *request_schema_hash; /* SHA-256 of the transitive request schema */
    const char *reply_type;   /* fully qualified FlatBuffers type */
    const char *reply_schema_hash; /* SHA-256 of the transitive reply schema */
    const char *request_encoding;
    size_t request_size; /* zero when request_encoding is table */
    const char *reply_encoding;
    size_t reply_size; /* zero when reply_encoding is table */
    const char *description;
} synapse_command_info_t;

static const synapse_topic_info_t synapse_topics[] = {
{%- for topic in topics %}
    {
        {{ topic.id }},
        {{ topic.name|tojson }},
        {{ topic.key|tojson }},
        {{ topic.root_table|tojson }},
        {% if topic.payload_type %}{{ topic.payload_type|tojson }}{% else %}NULL{% endif %},
        {% if topic.payload_size is not none %}{{ topic.payload_size }}{% else %}0{% endif %},
        {{ topic.schema_file|tojson }},
        {{ topic.mcap_schema_name|tojson }},
        {{ topic.mcap_schema_file|tojson }},
        {{ topic.wire_type|tojson }},
        {{ topic.schema_hash|tojson }},
        {{ topic.fixed_layout }},
        {{ topic.multi_instance }},
        {{ topic.scope|tojson }},
        {{ topic.encoding|tojson }},
        {{ topic.description|tojson }},
    },
{%- endfor %}
};

static const size_t synapse_topics_count =
    sizeof(synapse_topics) / sizeof(synapse_topics[0]);

static const synapse_command_info_t synapse_commands[] = {
{%- for command in commands %}
    {
        {{ command.id }},
        {{ command.name|tojson }},
        {{ command.key|tojson }},
        {{ command.request_type|tojson }},
        {{ command.request_schema_hash|tojson }},
        {{ command.reply_type|tojson }},
        {{ command.reply_schema_hash|tojson }},
        {{ command.request_encoding|tojson }},
        {% if command.request_size is not none %}{{ command.request_size }}{% else %}0{% endif %},
        {{ command.reply_encoding|tojson }},
        {% if command.reply_size is not none %}{{ command.reply_size }}{% else %}0{% endif %},
        {{ command.description|tojson }},
    },
{%- endfor %}
};

static const size_t synapse_commands_count =
    sizeof(synapse_commands) / sizeof(synapse_commands[0]);

static inline const synapse_topic_info_t *synapse_topic_by_id(uint16_t id) {
    for (size_t i = 0; i < synapse_topics_count; ++i) {
        if (synapse_topics[i].id == id) {
            return &synapse_topics[i];
        }
    }
    return NULL;
}

static inline const synapse_topic_info_t *synapse_topic_by_name(const char *name) {
    if (name == NULL) {
        return NULL;
    }
    for (size_t i = 0; i < synapse_topics_count; ++i) {
        if (strcmp(synapse_topics[i].name, name) == 0) {
            return &synapse_topics[i];
        }
    }
    return NULL;
}

static inline const synapse_topic_info_t *synapse_topic_by_key_segment(
    const char *segment, size_t length) {
    for (size_t i = 0; i < synapse_topics_count; ++i) {
        if (strlen(synapse_topics[i].key) == length &&
            strncmp(synapse_topics[i].key, segment, length) == 0) {
            return &synapse_topics[i];
        }
    }
    return NULL;
}

/*
 * Parse a possibly namespaced topic key expression such as "cub1/odom",
 * "qualisys/cub1/external_pose", or "cub1/imu/0". The topic key is the last
 * segment, or the second-to-last when an instance segment follows; everything
 * before it is the deployment namespace. Leading and trailing slashes are
 * ignored. On success returns the catalog entry and writes the namespace
 * substring (start pointer into `key` and length, empty when absent) and the
 * instance segment (-1 when absent). Out parameters may be NULL. Instance
 * segments are 1 to 9 ASCII digits, and topic keys never consist solely of
 * digits; this grammar is identical in the Rust, Python, JavaScript, and C
 * catalog helpers.
 */
static inline const synapse_topic_info_t *synapse_topic_parse_key(
    const char *key, const char **namespace_start, size_t *namespace_len,
    int32_t *instance) {
    if (key == NULL) {
        return NULL;
    }
    while (*key == '/') {
        ++key;
    }
    const char *end = key + strlen(key);
    while (end > key && end[-1] == '/') {
        --end;
    }
    if (end == key) {
        return NULL;
    }

    /* Last segment: a topic key, or instance digits preceded by one. */
    const char *last = end;
    while (last > key && last[-1] != '/') {
        --last;
    }
    const char *name_start = last;
    int32_t parsed_instance = -1;
    const synapse_topic_info_t *topic =
        synapse_topic_by_key_segment(last, (size_t)(end - last));
    if (topic == NULL) {
        size_t digits = (size_t)(end - last);
        if (digits == 0 || digits > 9 || last == key) {
            return NULL;
        }
        int32_t value = 0;
        for (size_t i = 0; i < digits; ++i) {
            if (last[i] < '0' || last[i] > '9') {
                return NULL;
            }
            value = value * 10 + (last[i] - '0');
        }
        const char *name_end = last - 1; /* the '/' before the instance */
        name_start = name_end;
        while (name_start > key && name_start[-1] != '/') {
            --name_start;
        }
        topic = synapse_topic_by_key_segment(name_start,
                                             (size_t)(name_end - name_start));
        if (topic == NULL) {
            return NULL;
        }
        parsed_instance = value;
    }

    if (namespace_start != NULL || namespace_len != NULL) {
        size_t length = (size_t)(name_start - key);
        while (length > 0 && key[length - 1] == '/') {
            --length;
        }
        if (namespace_start != NULL) {
            *namespace_start = key;
        }
        if (namespace_len != NULL) {
            *namespace_len = length;
        }
    }
    if (instance != NULL) {
        *instance = parsed_instance;
    }
    return topic;
}

static inline const synapse_topic_info_t *synapse_topic_by_key(const char *key) {
    if (key == NULL) {
        return NULL;
    }
    while (*key == '/') {
        ++key;
    }
    for (size_t i = 0; i < synapse_topics_count; ++i) {
        if (strcmp(synapse_topics[i].key, key) == 0) {
            return &synapse_topics[i];
        }
    }
    return synapse_topic_parse_key(key, NULL, NULL, NULL);
}

static inline const synapse_command_info_t *synapse_command_by_name(const char *name) {
    if (name == NULL) {
        return NULL;
    }
    for (size_t i = 0; i < synapse_commands_count; ++i) {
        if (strcmp(synapse_commands[i].name, name) == 0) {
            return &synapse_commands[i];
        }
    }
    return NULL;
}

