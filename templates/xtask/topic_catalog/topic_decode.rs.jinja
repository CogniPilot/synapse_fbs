// Generated by xtask from the topic catalog. Decodes catalog topic payloads
// (canonical bare-struct or root-table encodings) and renders them through
// the generated bindings' Debug implementations. This is the Rust
// counterpart of the generated C topic_print field-descriptor printer.

use crate::topic_catalog::TopicInfo;

/// Why a topic payload failed to decode.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum DecodeError {
    /// The topic id has no generated decoder.
    UnknownTopic,
    /// A fixed-layout payload did not match the catalog payload size.
    PayloadSize { expected: usize, actual: usize },
    /// A root-table payload failed FlatBuffers verification.
    InvalidFlatbuffer,
}

impl core::fmt::Display for DecodeError {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        match self {
            Self::UnknownTopic => write!(f, "topic has no generated decoder"),
            Self::PayloadSize { expected, actual } => {
                write!(f, "payload is {actual} bytes, catalog expects {expected}")
            }
            Self::InvalidFlatbuffer => write!(f, "payload failed FlatBuffers verification"),
        }
    }
}

impl std::error::Error for DecodeError {}

fn decode_struct<'a, T>(payload: &'a [u8], expected: usize) -> Result<T::Inner, DecodeError>
where
    T: flatbuffers::Follow<'a>,
{
    if payload.len() != expected {
        return Err(DecodeError::PayloadSize {
            expected,
            actual: payload.len(),
        });
    }
    // Safety: generated fixed-layout structs are repr(transparent) byte
    // arrays with unaligned accessors, and the exact-size check above
    // guarantees the buffer covers the struct.
    Ok(unsafe { T::follow(payload, 0) })
}

fn decode_table<'a, T>(payload: &'a [u8]) -> Result<T::Inner, DecodeError>
where
    T: flatbuffers::Follow<'a> + flatbuffers::Verifiable + 'a,
{
    flatbuffers::root::<T>(payload).map_err(|_| DecodeError::InvalidFlatbuffer)
}

/// Fully qualified FlatBuffers type of the wire payload: the bare struct for
/// fixed-layout topics, the root table otherwise.
pub fn topic_wire_type(topic: &TopicInfo) -> Option<&'static str> {
    match topic.id {
{%- for topic in topics %}
{%- if topic.fixed_layout %}
        {{ topic.id }} => Some({{ topic.payload_type_qualified|tojson }}),
{%- else %}
        {{ topic.id }} => Some({{ topic.root_table_qualified|tojson }}),
{%- endif %}
{%- endfor %}
        _ => None,
    }
}

/// Decode `payload` for `topic` and render it with the generated bindings'
/// pretty `Debug` format ("{:#?}").
pub fn decode_topic_debug(topic: &TopicInfo, payload: &[u8]) -> Result<String, DecodeError> {
    match topic.id {
{%- for topic in topics %}
{%- if topic.fixed_layout %}
        {{ topic.id }} => decode_struct::<crate::generated::{{ topic.payload_type_rust_path }}>(
            payload,
            {{ topic.payload_size }},
        )
        .map(|value| format!("{value:#?}")),
{%- else %}
        {{ topic.id }} => decode_table::<crate::generated::{{ topic.root_table_rust_path }}>(payload)
            .map(|value| format!("{value:#?}")),
{%- endif %}
{%- endfor %}
        _ => Err(DecodeError::UnknownTopic),
    }
}
