"""Generated Synapse topic catalog helpers."""
from dataclasses import dataclass
from typing import Optional, Union

CMD_KEY_PREFIX = {{ cmd_key_prefix|tojson }}
META_KEY_PREFIX = {{ meta_key_prefix|tojson }}
LIVELINESS_KEY_PREFIX = {{ liveliness_key_prefix|tojson }}
SCHEMA_SET_HASH = {{ schema_set_hash|tojson }}
MCAP_PROFILE = {{ mcap_profile|tojson }}
MCAP_SCHEMA_ENCODING = {{ mcap_schema_encoding|tojson }}
MCAP_MESSAGE_ENCODING = {{ mcap_message_encoding|tojson }}
MCAP_METADATA_NAME = {{ mcap_metadata_name|tojson }}
MCAP_SCHEMA_SET_HASH_KEY = {{ mcap_schema_set_hash_key|tojson }}
MCAP_SESSION_ID_KEY = {{ mcap_session_id_key|tojson }}
MCAP_SOURCE_KEY = {{ mcap_source_key|tojson }}
MCAP_TIME_BASIS_KEY = {{ mcap_time_basis_key|tojson }}
MCAP_TIME_BASIS_MONOTONIC_BOOT = {{ mcap_time_basis_monotonic_boot|tojson }}
MCAP_TIME_BASIS_UNIX_EPOCH = {{ mcap_time_basis_unix_epoch|tojson }}
MCAP_TIME_BASIS_CORRELATED = {{ mcap_time_basis_correlated|tojson }}
MCAP_TOPIC_ID_KEY = {{ mcap_topic_id_key|tojson }}


@dataclass(frozen=True)
class TopicInfo:
    id: int
    name: str
    key: str
    root_table: str
    payload_type: Optional[str]
    payload_size: Optional[int]
    schema_file: str
    mcap_schema_name: str
    mcap_schema_file: str
    wire_type: str
    schema_hash: str
    fixed_layout: bool
    multi_instance: bool
    scope: str
    encoding: str
    description: str


@dataclass(frozen=True)
class CommandInfo:
    id: int
    name: str
    key: str
    request_type: str
    request_schema_hash: str
    reply_type: str
    reply_schema_hash: str
    request_encoding: str
    request_size: Optional[int]
    reply_encoding: str
    reply_size: Optional[int]
    description: str


@dataclass(frozen=True)
class ParsedTopicKey:
    namespace: str
    topic: TopicInfo
    instance: Optional[int]


TOPICS = (
{%- for topic in topics %}
    TopicInfo(
        id={{ topic.id }},
        name={{ topic.name|tojson }},
        key={{ topic.key|tojson }},
        root_table={{ topic.root_table|tojson }},
        payload_type={% if topic.payload_type %}{{ topic.payload_type|tojson }}{% else %}None{% endif %},
        payload_size={% if topic.payload_size is not none %}{{ topic.payload_size }}{% else %}None{% endif %},
        schema_file={{ topic.schema_file|tojson }},
        mcap_schema_name={{ topic.mcap_schema_name|tojson }},
        mcap_schema_file={{ topic.mcap_schema_file|tojson }},
        wire_type={{ topic.wire_type|tojson }},
        schema_hash={{ topic.schema_hash|tojson }},
        fixed_layout={% if topic.fixed_layout %}True{% else %}False{% endif %},
        multi_instance={% if topic.multi_instance %}True{% else %}False{% endif %},
        scope={{ topic.scope|tojson }},
        encoding={{ topic.encoding|tojson }},
        description={{ topic.description|tojson }},
    ),
{%- endfor %}
)

COMMANDS = (
{%- for command in commands %}
    CommandInfo(
        id={{ command.id }},
        name={{ command.name|tojson }},
        key={{ command.key|tojson }},
        request_type={{ command.request_type|tojson }},
        request_schema_hash={{ command.request_schema_hash|tojson }},
        reply_type={{ command.reply_type|tojson }},
        reply_schema_hash={{ command.reply_schema_hash|tojson }},
        request_encoding={{ command.request_encoding|tojson }},
        request_size={% if command.request_size is not none %}{{ command.request_size }}{% else %}None{% endif %},
        reply_encoding={{ command.reply_encoding|tojson }},
        reply_size={% if command.reply_size is not none %}{{ command.reply_size }}{% else %}None{% endif %},
        description={{ command.description|tojson }},
    ),
{%- endfor %}
)

_TOPIC_BY_ID = {topic.id: topic for topic in TOPICS}
_TOPIC_BY_NAME = {topic.name: topic for topic in TOPICS}
_TOPIC_BY_KEY = {topic.key: topic for topic in TOPICS}
_COMMAND_BY_NAME = {command.name: command for command in COMMANDS}


def _normalize_key(key: str) -> str:
    return str(key).strip("/")


_INSTANCE_DIGITS = frozenset("0123456789")


def _parse_instance(segment: str) -> Optional[int]:
    """Instance segments are 1 to 9 ASCII digits; this grammar is identical
    in the Rust, Python, JavaScript, and C catalog helpers."""
    if not segment or len(segment) > 9 or not set(segment) <= _INSTANCE_DIGITS:
        return None
    return int(segment)


def topic_by_id(topic_id: int) -> Optional[TopicInfo]:
    return _TOPIC_BY_ID.get(int(topic_id))


def topic_by_name(name: str) -> Optional[TopicInfo]:
    return _TOPIC_BY_NAME.get(str(name))


def parse_key(key: str) -> Optional[ParsedTopicKey]:
    """Parse a possibly namespaced topic key expression.

    Accepts keys such as ``cub1/odom``, ``qualisys/cub1/external_pose``, and
    ``cub1/imu/0``. The topic key is the last segment, or the second-to-last
    when an instance segment follows; everything before it is the deployment
    namespace, which may be empty or contain multiple segments.
    """
    trimmed = _normalize_key(key)
    if not trimmed:
        return None
    rest, _, last = trimmed.rpartition("/")
    topic = _TOPIC_BY_KEY.get(last)
    if topic is not None:
        return ParsedTopicKey(namespace=rest.rstrip("/"), topic=topic, instance=None)

    # Topic keys never consist solely of digits, so a trailing instance
    # segment is unambiguous.
    instance = _parse_instance(last)
    if instance is None:
        return None
    namespace, _, name = rest.rpartition("/")
    topic = _TOPIC_BY_KEY.get(name)
    if topic is None:
        return None
    return ParsedTopicKey(namespace=namespace.rstrip("/"), topic=topic, instance=instance)


def topic_by_key(key: str) -> Optional[TopicInfo]:
    normalized = str(key).lstrip("/")
    direct = _TOPIC_BY_KEY.get(normalized)
    if direct is not None:
        return direct
    parsed = parse_key(normalized)
    return None if parsed is None else parsed.topic


def key_for_topic(topic: Union[int, str]) -> Optional[str]:
    info = (
        topic_by_id(topic)
        if isinstance(topic, int)
        else topic_by_name(topic) or topic_by_key(topic)
    )
    return None if info is None else info.key


def command_by_name(name: str) -> Optional[CommandInfo]:
    return _COMMAND_BY_NAME.get(str(name))
