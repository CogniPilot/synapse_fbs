// Generated by xtask from fbs/*.fbs. Embeds the schema sources and their
// compiled binary schemas so downstream tools (loggers, CLIs, bridges) ship
// the exact wire contract of this release instead of vendoring copies.

/// One embedded FlatBuffers schema file with its compiled binary schema.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct EmbeddedSchema {
    /// Schema stem, for example "state".
    pub name: &'static str,
    /// Repo-relative source path, for example "fbs/state.fbs". Matches
    /// `TopicInfo::schema_file` in the topic catalog.
    pub file: &'static str,
    /// FlatBuffers schema source text.
    pub fbs: &'static str,
    /// Compiled binary schema (`flatc --schema -b`), a reflection.fbs root.
    /// Includes are flattened, so each entry is self-contained.
    pub bfbs: &'static [u8],
    /// Full SHA-256 digest of the exact compiled BFBS bytes.
    pub bfbs_sha256: &'static str,
    /// Fully qualified declared root type, when the file declares one.
    pub root_type: Option<&'static str>,
    /// Declared file identifier, when the file declares one.
    pub file_identifier: Option<&'static str>,
}

pub const SCHEMAS: &[EmbeddedSchema] = &[
{%- for schema in schemas %}
    EmbeddedSchema {
        name: {{ schema.name|tojson }},
        file: {{ schema.file|tojson }},
        fbs: include_str!({{ schema.fbs_include|tojson }}),
        bfbs: include_bytes!({{ schema.bfbs_include|tojson }}),
        bfbs_sha256: {{ schema.bfbs_sha256|tojson }},
        root_type: {% if schema.root_type %}Some({{ schema.root_type|tojson }}){% else %}None{% endif %},
        file_identifier: {% if schema.file_identifier %}Some({{ schema.file_identifier|tojson }}){% else %}None{% endif %},
    },
{%- endfor %}
];

/// Look up an embedded schema by stem ("state") or source path ("fbs/state.fbs").
pub fn schema_by_name(name: &str) -> Option<&'static EmbeddedSchema> {
    SCHEMAS
        .iter()
        .find(|schema| schema.name == name || schema.file == name)
}
