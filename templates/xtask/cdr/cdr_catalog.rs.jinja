    pub fn decode(bytes: &[u8]) -> Result<Self, CdrError> {
        let mut reader = CdrReader::new_le(bytes)?;
        let value = Self {
{%- for field in projection.fields %}
            {{ field.name }}: {% if field.count > 1 %}[
{%- for unused in range(field.count) %}
