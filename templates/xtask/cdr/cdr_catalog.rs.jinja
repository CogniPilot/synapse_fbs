impl {{ projection.ros_message }}Cdr {
    pub fn encode(&self, bytes: &mut [u8]) -> Result<usize, CdrError> {
        let mut writer = CdrWriter::new_le(bytes)?;
{%- for field in projection.fields %}
{%- if field.count > 1 %}
        for value in self.{{ field.name }} {
