cmake_minimum_required(VERSION 3.20)
project(synapse_fbs_find_package_cpp_smoke CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(synapse_fbs {{ package_version }} CONFIG REQUIRED)

if(NOT TARGET synapse_fbs::cpp)
  message(FATAL_ERROR "missing target: synapse_fbs::cpp")
endif()
if(NOT TARGET synapse_fbs::mcap)
  message(FATAL_ERROR "missing target: synapse_fbs::mcap")
endif()

add_executable(smoke main.cpp)
target_link_libraries(smoke PRIVATE synapse_fbs::mcap)
