{
  "name": "@cognipilot/synapse-fbs",
  "version": "{{ package_version }}",
  "description": "Canonical Synapse FlatBuffers schemas and generated reflection assets for JavaScript and TypeScript",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CogniPilot/synapse_fbs.git"
  },
  "homepage": "https://github.com/CogniPilot/synapse_fbs",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./topic_catalog": {
      "types": "./topic_catalog.d.ts",
      "default": "./topic_catalog.js"
    },
    "./mcap": {
      "types": "./mcap.d.ts",
      "default": "./mcap.js"
    },
    "./topics.json": "./topics.json",
    "./fbs/*": "./fbs/*",
    "./bfbs/*": "./bfbs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "topic_catalog.js",
    "topic_catalog.d.ts",
    "mcap.js",
    "mcap.d.ts",
    "topics.json",
    "fbs",
    "bfbs",
    "schema.sha256",
    "bfbs.sha256",
    "README.md",
    "MCAP.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@mcap/core": "{{ mcap_javascript_version }}"
  },
  "peerDependenciesMeta": {
    "@mcap/core": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
