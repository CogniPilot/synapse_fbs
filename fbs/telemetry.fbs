include "types.fbs";

namespace synapse.topic;

/// Status bits for GcsStatusData.flags.
enum GcsStatusFlags:ubyte (bit_flags) {
  /// Actuators are allowed to produce motion.
  Armed,
  /// An active failsafe is affecting vehicle behavior.
  Failsafe,
  /// The latitude/longitude/altitude fields are usable.
  GlobalPositionValid,
  /// The yaw field is usable.
  YawValid,
  /// A home reference is set and distance_home_dam is meaningful.
  HomeSet,
  /// The manual control link is healthy.
  RcLink,
  /// The ground-control link is healthy.
  GcsLink,
}

/// Compact vehicle status aggregate for low-rate ground-control links such as
/// LoRa or satellite backhaul. This is a display-oriented estimate-layer
/// summary published at 0.2 to 1 Hz; it is never used for control. Angles
/// follow REP-0103: zero east, positive counter-clockwise.
struct GcsStatusData {
  /// Sample timestamp in monotonic boot time.
  time_boot_ms:uint (unit: "s", clock: "monotonic_boot", scale: "1e-3", min: "0");
  /// Latitude in WGS-84 degrees scaled by 1e7.
  latitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-90", max: "90");
  /// Longitude in WGS-84 degrees scaled by 1e7.
  longitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-180", max: "180");
  /// Height above mean sea level.
  altitude_msl_m:short (unit: "m");
  /// Height above the home reference.
  relative_altitude_m:short (unit: "m");
  /// Heading in the range -18000 to 18000; zero east, positive counter-clockwise.
  yaw_cdeg:short (unit: "deg", scale: "1e-2", min: "-180", max: "180");
  /// Horizontal ground speed magnitude.
  ground_speed_cm_s:ushort (unit: "m/s", scale: "1e-2", min: "0");
  /// Vertical speed, positive up.
  climb_cm_s:short (unit: "m/s", scale: "1e-2");
  /// Straight-line distance to home in decameters.
  distance_home_dam:ushort (unit: "m", scale: "10", min: "0");
  /// Primary battery pack voltage in centi-volts.
  voltage_battery_cv:ushort (unit: "V", scale: "1e-2", min: "0");
  /// Primary battery current in deci-amps; positive means discharge.
  current_battery_da:short (unit: "A", scale: "1e-1");
  /// Current mission item sequence number.
  mission_seq:ushort;
  /// Remaining battery percentage, or negative when unknown.
  battery_remaining_pct:byte (unit: "%", min: "0", max: "100", valid_if: "value >= 0");
  /// Producer-defined active flight mode.
  flight_mode:ubyte;
  /// Producer-defined high-level system state.
  system_state:ubyte;
  /// Command/control link quality from 0 to 100.
  link_quality_pct:ubyte (unit: "%", min: "0", max: "100");
  /// Number of GNSS satellites used in the solution.
  satellites_used:ubyte;
  /// GNSS fix quality.
  fix_type:synapse.types.GnssFixType;
  /// Bitmask of GcsStatusFlags bits.
  flags:ubyte;
}

/// FlatBuffers root wrapper for GcsStatusData.
table GcsStatus {
  /// Fixed-layout ground-control status payload.
  data:GcsStatusData;
}
