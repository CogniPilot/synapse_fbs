include "types.fbs";

namespace synapse.cmd;

/// Firmware update state reported by the update service. Update commands are
/// accepted only while the producer is in a safe maintenance state; normal
/// flight-control topics must not accept image writes.
enum FirmwareUpdateState:ubyte {
  /// Firmware update state is not known or not reported.
  Unknown = 0,
  /// Update commands are rejected because the vehicle is not in maintenance mode.
  FlightLocked = 1,
  /// Safe to prepare an update.
  MaintenanceReady = 2,
  /// Image chunks are being staged.
  Receiving = 3,
  /// Staged image hash/signature is being checked.
  Verifying = 4,
  /// Full image is staged and ready for commit.
  ReadyToCommit = 5,
  /// Image was committed for bootloader test boot.
  Committed = 6,
  /// New image is confirmed.
  Complete = 7,
  /// Update failed before the new image was confirmed.
  Failed = 8,
  /// Update was cancelled and staged image data should be discarded.
  Aborted = 9,
}

/// Optional safety flags explaining which maintenance gates are currently true.
enum FirmwareMaintenanceFlags:ushort (bit_flags) {
  /// Vehicle is disarmed.
  Disarmed,
  /// Vehicle is known to be on the ground.
  OnGround,
  /// Motor or actuator outputs are inhibited.
  MotorsDisabled,
  /// No autonomous mission is actively executing.
  NoActiveMission,
  /// Battery level is adequate for maintenance actions.
  AdequateBattery,
  /// Firmware update maintenance mode is explicitly enabled.
  MaintenanceEnabled,
}

/// Query target firmware/update capabilities.
table FirmwareInfoRequest {
  /// Firmware target, board, or component selector; empty means default.
  target:string;
}

/// Reply to FirmwareInfoRequest.
table FirmwareInfoReply {
  /// Result of the capability query.
  result:synapse.types.CommandResultCode;
  /// Firmware target, board, or component selected by the producer.
  target:string;
  /// Hardware board identifier for compatibility checks.
  board_id:string;
  /// Currently active firmware version or build identifier.
  active_version:string;
  /// Bootloader or update mechanism identifier.
  bootloader:string;
  /// Current firmware update state.
  state:FirmwareUpdateState;
  /// Bitmask of FirmwareMaintenanceFlags bits.
  maintenance_flags:ushort;
  /// Maximum accepted image size in bytes.
  max_image_size:ulong (unit: "By", min: "0");
  /// Maximum accepted chunk payload size in bytes.
  max_chunk_size:uint (unit: "By", min: "0");
  /// Human-readable diagnostic text.
  message:string;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}

/// Query the status of one update, or the current update when update_id is empty.
table FirmwareStatusRequest {
  /// Update identifier to query, or empty for the current update.
  update_id:string;
}

/// Reply to FirmwareStatusRequest.
table FirmwareStatusReply {
  /// Result of the status query.
  result:synapse.types.CommandResultCode;
  /// Update identifier this status describes.
  update_id:string;
  /// Current firmware update state.
  state:FirmwareUpdateState;
  /// Bytes successfully staged for this update.
  received_bytes:ulong (unit: "By", min: "0");
  /// Expected total image size in bytes.
  total_bytes:ulong (unit: "By", min: "0");
  /// Chunks successfully staged for this update.
  received_chunks:uint;
  /// Expected total chunk count.
  total_chunks:uint;
  /// Completion progress from 0 to 100.
  progress_pct:ubyte (unit: "%", min: "0", max: "100");
  /// Human-readable diagnostic text.
  message:string;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}

/// Prepare to receive a firmware image. The producer must reject this unless
/// the vehicle is in maintenance mode and the image metadata is compatible.
table FirmwarePrepareRequest {
  /// Client-generated identifier for this firmware update.
  update_id:string;
  /// Firmware target, board, or component selector.
  target:string;
  /// Expected hardware board identifier.
  board_id:string;
  /// Candidate firmware version or build identifier.
  version:string;
  /// Candidate image size in bytes.
  image_size:ulong (unit: "By", min: "0");
  /// Lowercase hexadecimal SHA-256 hash of the full candidate image.
  image_sha256:string;
  /// Lowercase hexadecimal SHA-256 hash after omitting producer-authorized mutable regions.
  selective_sha256:string;
  /// Requested chunk payload size in bytes.
  requested_chunk_size:uint (unit: "By", min: "0");
  /// Number of chunks the client will send.
  chunk_count:uint;
  /// Optional signature or authentication token for the image.
  signature:[ubyte];
  /// Optional UTF-8 JSON manifest for policy-specific metadata.
  manifest:string;
}

/// Reply to FirmwarePrepareRequest.
table FirmwarePrepareReply {
  /// Result of the prepare request.
  result:synapse.types.CommandResultCode;
  /// Update identifier accepted or rejected by the producer.
  update_id:string;
  /// Firmware update state after prepare handling.
  state:FirmwareUpdateState;
  /// Chunk payload size the producer accepts in bytes.
  accepted_chunk_size:uint (unit: "By", min: "0");
  /// Human-readable diagnostic text.
  message:string;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}

/// One image chunk. Chunks are idempotent: resending the same update_id,
/// chunk_index, offset, data, and chunk_sha256 must be safe.
table FirmwareChunkRequest {
  /// Update identifier returned by prepare.
  update_id:string;
  /// Zero-based chunk index.
  chunk_index:uint;
  /// Byte offset of this chunk within the image.
  offset:ulong (unit: "By", min: "0");
  /// Raw firmware image bytes for this chunk.
  data:[ubyte];
  /// Lowercase hexadecimal SHA-256 hash of this chunk's data bytes.
  chunk_sha256:string;
  /// True when this is the last chunk for the image.
  final_chunk:bool;
}

/// Reply to FirmwareChunkRequest.
table FirmwareChunkReply {
  /// Result of the chunk request.
  result:synapse.types.CommandResultCode;
  /// Update identifier this reply describes.
  update_id:string;
  /// Firmware update state after chunk handling.
  state:FirmwareUpdateState;
  /// Chunk index this reply acknowledges.
  chunk_index:uint;
  /// Bytes successfully staged for this update.
  received_bytes:ulong (unit: "By", min: "0");
  /// Chunks successfully staged for this update.
  received_chunks:uint;
  /// Completion progress from 0 to 100.
  progress_pct:ubyte (unit: "%", min: "0", max: "100");
  /// Human-readable diagnostic text.
  message:string;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}

/// Verify and commit the staged image for bootloader test boot.
table FirmwareCommitRequest {
  /// Update identifier whose staged image should be committed.
  update_id:string;
  /// Expected lowercase hexadecimal SHA-256 hash of the full staged image.
  image_sha256:string;
}

/// Reply to FirmwareCommitRequest.
table FirmwareCommitReply {
  /// Result of the commit request.
  result:synapse.types.CommandResultCode;
  /// Update identifier this reply describes.
  update_id:string;
  /// Firmware update state after commit handling.
  state:FirmwareUpdateState;
  /// True when a reboot is required to activate the image.
  reboot_required:bool;
  /// Human-readable diagnostic text.
  message:string;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}

/// Abort the current update and discard staged image data.
table FirmwareAbortRequest {
  /// Update identifier to abort.
  update_id:string;
  /// Human-readable reason for aborting the update.
  reason:string;
}

/// Reply to FirmwareAbortRequest.
table FirmwareAbortReply {
  /// Result of the abort request.
  result:synapse.types.CommandResultCode;
  /// Update identifier this reply describes.
  update_id:string;
  /// Firmware update state after abort handling.
  state:FirmwareUpdateState;
  /// Human-readable diagnostic text.
  message:string;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}

namespace synapse.topic;

/// Optional payload for synapse/v1/topic/firmware_progress. Command replies
/// and FirmwareStatusReply remain authoritative; this topic supports UI and
/// logging updates while a long transfer is running.
table FirmwareProgress {
  /// Progress publication timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Update identifier this progress sample describes.
  update_id:string;
  /// Current firmware update state.
  state:synapse.cmd.FirmwareUpdateState;
  /// Current command result or progress result.
  result:synapse.types.CommandResultCode;
  /// Bytes successfully staged for this update.
  received_bytes:ulong (unit: "By", min: "0");
  /// Expected total image size in bytes.
  total_bytes:ulong (unit: "By", min: "0");
  /// Chunks successfully staged for this update.
  received_chunks:uint;
  /// Expected total chunk count.
  total_chunks:uint;
  /// Completion progress from 0 to 100.
  progress_pct:ubyte (unit: "%", min: "0", max: "100");
  /// Human-readable diagnostic text.
  message:string;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}
