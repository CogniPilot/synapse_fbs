include "types.fbs";

namespace synapse.topic;

/// Raw motion-capture component type represented by a sample.
enum MocapRawComponent:ubyte {
  /// Component type is not reported.
  Unknown = 0,
  /// Labeled 3D marker sample.
  Marker3d = 1,
  /// Unlabeled 3D marker sample with a source-assigned tracking id.
  Marker3dNoLabel = 2,
  /// Six-degree-of-freedom rigid-body sample with rotation matrix.
  RigidBody6d = 3,
}

/// Validity and source-detail bits for raw mocap samples.
enum MocapRawFlags:ushort (bit_flags) {
  /// Position and rotation fields are meaningful.
  Valid,
  /// residual_mm is meaningful.
  ResidualValid,
  /// id indexes a known source label or rigid-body definition.
  LabelValid,
  /// id is a source-assigned tracking id.
  TrackingIdValid,
}

/// Raw 3D marker sample. The bridge converts coordinates into ENU meters while
/// preserving the source marker id and residual.
struct MocapMarkerData {
  /// Marker position in local/world ENU.
  position_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Source solve residual in millimeters.
  residual_mm:float (unit: "m", scale: "1e-3", min: "0", valid_if: "flags.ResidualValid");
  /// Label index or tracking id from the mocap source.
  id:int;
  /// Bitmask of MocapRawFlags bits.
  flags:ushort;
  /// Labeled or unlabeled 3D component class.
  component:MocapRawComponent;
}

/// Raw 6DOF rigid-body sample. The bridge converts coordinates into ENU meters
/// while preserving the source rotation matrix and residual.
struct MocapRigidBodyData {
  /// Rigid-body position in local/world ENU.
  position_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Rotation matrix from body FLU to ENU.
  rotation:synapse.types.RotationMatrix3f (logical_type: "rotation_matrix_flu_to_enu");
  /// Source 6DOF solve residual in millimeters.
  residual_mm:float (unit: "m", scale: "1e-3", min: "0", valid_if: "flags.ResidualValid");
  /// Rigid-body definition index from the mocap source.
  id:int;
  /// Bitmask of MocapRawFlags bits.
  flags:ushort;
  /// RigidBody6d for current producers.
  component:MocapRawComponent;
}

/// Raw 6DOF rigid-body pose with the preferred Synapse quaternion attitude.
struct MocapRigidBodyPoseData {
  /// Rigid-body position and body-FLU-to-ENU quaternion attitude.
  pose:synapse.types.Posef;
  /// Source 6DOF solve residual in millimeters.
  residual_mm:float (unit: "m", scale: "1e-3", min: "0", valid_if: "flags.ResidualValid");
  /// Rigid-body definition index from the mocap source.
  id:int;
  /// Bitmask of MocapRawFlags bits.
  flags:ushort;
}

/// Raw mocap frame for logging, debugging, and bridge-level processing. This is
/// intentionally table-encoded; estimators should consume ExternalOdometry.
table MocapFrame {
  /// Marker timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Source frame number.
  frame_number:uint;
  /// Recent 2D camera-frame drop rate in deci-percent.
  drop_rate_2d_dpermille:ushort (unit: "1", scale: "1e-3", min: "0", max: "1");
  /// Recent 2D camera-frame out-of-sync rate in deci-percent.
  out_of_sync_rate_2d_dpermille:ushort (unit: "1", scale: "1e-3", min: "0", max: "1");
  /// Mocap source instance identifier.
  source_id:ubyte;
  /// Bitmask of MocapRawFlags bits describing the frame as a whole.
  flags:ushort;
  /// Labeled marker samples.
  markers:[MocapMarkerData];
  /// Unlabeled marker samples.
  unlabeled_markers:[MocapMarkerData];
  /// Six-degree-of-freedom rigid-body samples.
  rigid_bodies:[MocapRigidBodyData];
}

/// Raw mocap frame using quaternion attitude for rigid bodies. This supersedes
/// MocapFrame for new publishers while the matrix-based wire type remains
/// available for compatibility with existing recordings and consumers.
table MocapPoseFrame {
  /// Marker timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Source frame number.
  frame_number:uint;
  /// Recent 2D camera-frame drop rate in deci-percent.
  drop_rate_2d_dpermille:ushort (unit: "1", scale: "1e-3", min: "0", max: "1");
  /// Recent 2D camera-frame out-of-sync rate in deci-percent.
  out_of_sync_rate_2d_dpermille:ushort (unit: "1", scale: "1e-3", min: "0", max: "1");
  /// Mocap source instance identifier.
  source_id:ubyte;
  /// Bitmask of MocapRawFlags bits describing the frame as a whole.
  flags:ushort;
  /// Labeled marker samples.
  markers:[MocapMarkerData];
  /// Unlabeled marker samples.
  unlabeled_markers:[MocapMarkerData];
  /// Six-degree-of-freedom rigid-body pose samples.
  rigid_bodies:[MocapRigidBodyPoseData];
}
