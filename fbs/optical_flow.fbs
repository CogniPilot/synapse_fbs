include "types.fbs";

namespace synapse.topic;

/// Integrated optical-flow sample from an image sensor or flow module. This is
/// a raw-layer topic: flow is the sensor's integrated angular image motion.
struct OpticalFlowData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Integrated angular flow about the sensor X and Y axes in radians over integration_timespan_us.
  flow_rad:synapse.types.Vec2f (unit: "rad", frame: "sensor");
  /// Integrated body rotation in the FLU frame during the same interval.
  delta_angle_flu_rad:synapse.types.Vec3f (unit: "rad", frame: "flu");
  /// Measured distance to the observed surface.
  distance_m:float (unit: "m", min: "0");
  /// Integration interval for flow_rad and delta_angle_flu_rad.
  integration_timespan_us:uint (unit: "s", scale: "1e-6", min: "0");
  /// Maximum measurable angular flow rate.
  max_flow_rate_rad_s:float (unit: "rad/s", min: "0");
  /// Minimum valid range for distance-compensated flow.
  min_ground_distance_m:float (unit: "m", min: "0");
  /// Maximum valid range for distance-compensated flow.
  max_ground_distance_m:float (unit: "m", min: "0");
  /// Flow quality from 0 to 100.
  quality_pct:ubyte (unit: "%", min: "0", max: "100");
}

/// Velocity estimate derived from optical flow.
struct OpticalFlowVelocityData {
  /// Estimate timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Planar velocity estimate in the body FLU frame.
  velocity_flu_m_s:synapse.types.Vec2f (unit: "m/s", frame: "flu");
  /// Planar velocity estimate in the local ENU frame.
  velocity_enu_m_s:synapse.types.Vec2f (unit: "m/s", frame: "enu");
  /// Raw angular flow rate before gyro compensation.
  flow_rate_uncompensated_rad_s:synapse.types.Vec2f (unit: "rad/s", frame: "sensor");
  /// Angular flow rate after gyro compensation.
  flow_rate_compensated_rad_s:synapse.types.Vec2f (unit: "rad/s", frame: "sensor");
  /// Body angular rate used for compensation.
  gyro_flu_rad_s:synapse.types.Vec3f (unit: "rad/s", frame: "flu");
}

/// FlatBuffers root wrapper for OpticalFlowData.
table OpticalFlow {
  /// Fixed-layout optical-flow payload.
  data:OpticalFlowData;
}

/// FlatBuffers root wrapper for OpticalFlowVelocityData.
table OpticalFlowVelocity {
  /// Fixed-layout optical-flow velocity payload.
  data:OpticalFlowVelocityData;
}
