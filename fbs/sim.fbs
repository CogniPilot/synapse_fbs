include "semantic.fbs";

namespace synapse.topic;

/// Control bits for lockstep tick messages.
enum LockstepTickFlags:ushort (bit_flags) {
  /// Receiver should reset its lockstep state before applying this tick.
  Reset,
  /// This tick is the final tick in the current lockstep run.
  Final,
}

/// Participant state for lockstep status messages.
enum LockstepStatusState:ubyte {
  /// Participant state is not reported.
  Unknown = 0,
  /// Participant is initialized and ready to accept lockstep ticks.
  Ready = 1,
  /// Participant accepted a tick and is advancing to the target time.
  Running = 2,
  /// Participant reached the target boot time for sequence.
  Completed = 3,
  /// Participant reset its lockstep state in response to a Reset tick.
  ResetAck = 4,
  /// Participant observed a sequence gap or superseded tick.
  MissedTick = 5,
  /// Participant cannot continue without external recovery.
  Error = 6,
}

/// Deterministic simulation barrier from a simulator to a controller or device
/// under test. The receiver advances its monotonic boot clock until
/// target_boot_time_us, runs work made ready by that time, then waits for the
/// next tick.
struct LockstepTickData {
  /// Target receiver monotonic boot time for this step.
  target_boot_time_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Lockstep run identifier; changes when the simulator restarts the run.
  run_id:uint;
  /// Monotonic tick sequence used to pair status with this tick.
  sequence:uint;
  /// Bitmask of LockstepTickFlags bits.
  flags:ushort;
}

/// Deterministic simulation status from a controller or device under test back
/// to the simulator. The simulator waits for a matching completed sequence
/// before publishing the next tick when strict lockstep is required.
struct LockstepStatusData {
  /// Receiver monotonic boot time reached when this status was sampled.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Lockstep run identifier copied from the accepted tick.
  run_id:uint;
  /// Most recent lockstep tick sequence accepted or completed.
  sequence:uint;
  /// Compact participant-defined detail for MissedTick or Error states.
  result_detail:ushort;
  /// Participant state for this sequence.
  state:LockstepStatusState;
  /// Lockstep participant instance identifier; also the instance segment of the Zenoh key.
  id:ubyte;
}

/// FlatBuffers root wrapper for LockstepTickData.
table LockstepTick {
  /// Fixed-layout lockstep tick payload.
  data:LockstepTickData;
}

/// FlatBuffers root wrapper for LockstepStatusData.
table LockstepStatus {
  /// Fixed-layout lockstep status payload.
  data:LockstepStatusData;
}
