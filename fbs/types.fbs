/// Text and diagnostic severity levels following RFC 5424 syslog numbering.
enum Severity:ubyte {
  /// System is unusable; immediate operator action required.
  Emergency = 0,
  /// Action must be taken immediately.
  Alert = 1,
  /// Critical condition affecting flight safety.
  Critical = 2,
  /// Error condition; a function is not working.
  Error = 3,
  /// Warning condition; degraded but functional.
  Warning = 4,
  /// Normal but significant event.
  Notice = 5,
  /// Informational message.
  Informational = 6,
  /// Developer diagnostic message.
  Debug = 7,
}

/// Result of command or transfer request execution.
enum CommandResultCode:ubyte {
  /// Command was accepted and executed or scheduled.
  Accepted = 0,
  /// Valid command rejected in the current state; retry may succeed.
  TemporarilyRejected = 1,
  /// Command is valid but permanently refused in this configuration.
  Denied = 2,
  /// Command is unknown or not implemented by this producer.
  Unsupported = 3,
  /// Command was attempted and failed during execution.
  Failed = 4,
  /// Command accepted; execution continues and progress updates follow.
  InProgress = 5,
  /// Command execution was cancelled before completion.
  Cancelled = 6,
}

/// GNSS receiver fix quality.
enum GnssFixType:ubyte {
  /// No position solution.
  NoFix = 0,
  /// Time-only solution without position.
  TimeOnly = 1,
  /// Two-dimensional position fix.
  Fix2d = 2,
  /// Three-dimensional position fix.
  Fix3d = 3,
  /// Differentially corrected fix.
  Dgnss = 4,
  /// RTK solution with float ambiguities.
  RtkFloat = 5,
  /// RTK solution with fixed ambiguities.
  RtkFixed = 6,
  /// Dead-reckoning or combined solution without full GNSS observability.
  DeadReckoning = 7,
}

/// Battery or power-source charging state.
enum BatteryChargeState:ubyte {
  /// Charge state is not reported.
  Unknown = 0,
  /// Normal operation.
  Ok = 1,
  /// Low charge; operator attention advised.
  Low = 2,
  /// Critical charge; land or recover soon.
  Critical = 3,
  /// Emergency charge level; immediate action required.
  Emergency = 4,
  /// Battery failure detected.
  Failed = 5,
  /// Battery is degraded or operating outside limits.
  Unhealthy = 6,
  /// Battery is charging.
  Charging = 7,
}

/// Role a battery or power source plays on the vehicle.
enum BatteryFunction:ubyte {
  /// Function is not reported.
  Unknown = 0,
  /// Powers motors and propulsion.
  Propulsion = 1,
  /// Powers flight controllers and avionics.
  Avionics = 2,
  /// Powers a payload or auxiliary system.
  Payload = 3,
}

/// Battery chemistry or power-source type.
enum BatteryType:ubyte {
  /// Chemistry is not reported.
  Unknown = 0,
  /// Lithium polymer.
  LiPo = 1,
  /// Lithium ion.
  LiIon = 2,
  /// Lithium iron phosphate.
  LiFe = 3,
  /// Nickel metal hydride.
  NiMh = 4,
  /// Lead acid.
  Pb = 5,
}

/// Mission execution state.
enum MissionState:ubyte {
  /// Mission state is not reported.
  Unknown = 0,
  /// No mission is executing.
  Idle = 1,
  /// Mission is executing.
  Active = 2,
  /// Mission is paused and can resume.
  Paused = 3,
  /// Mission finished all items.
  Complete = 4,
}

/// Altitude reference frame for geographic commands and mission items.
enum GeoAltitudeFrame:ubyte {
  /// Altitude above mean sea level.
  Msl = 0,
  /// Altitude above the WGS-84 ellipsoid.
  Ellipsoid = 1,
  /// Altitude relative to the home reference.
  RelativeHome = 2,
  /// Altitude above terrain.
  Terrain = 3,
}

/// Local coordinate frame selector for local-frame commands.
enum LocalFrame:ubyte {
  /// Local ENU frame anchored at the active local origin.
  LocalEnu = 0,
  /// Vehicle body FLU frame.
  BodyFlu = 1,
}

namespace synapse.topic;

/// Stable numeric identifiers for well-known Synapse topics. Values are
/// contiguous and mirror the SynapseMessage union order in transport.fbs.
enum TopicId:ushort {
  /// Reserved value for invalid, unassigned, or externally named topics.
  Unknown = 0,
  /// Vehicle-level arming, failsafe, mode, link, and health summary.
  VehicleHealth = 1,
  /// Correlates boot-relative time with an absolute Unix time reference.
  TimeReference = 2,
  /// Raw receiver channel input and link quality.
  RadioControl = 3,
  /// Normalized manual pilot intent after input mapping.
  ManualControlCommand = 4,
  /// IMU, magnetometer, static pressure, and temperature sample.
  InertialSample = 5,
  /// Barometric and aerodynamic measurements used by fixed-wing control.
  AirData = 6,
  /// Battery, current, energy, and power-source state.
  PowerStatus = 7,
  /// Global navigation fix, accuracy, velocity, and heading information.
  GnssFix = 8,
  /// Integrated optical-flow sample from an image sensor or flow module.
  OpticalFlow = 9,
  /// Velocity estimate derived from optical flow.
  OpticalFlowVelocity = 10,
  /// Vehicle attitude estimate and angular velocity.
  AttitudeEstimate = 11,
  /// Local ENU position, velocity, acceleration, and yaw estimate.
  LocalPositionEstimate = 12,
  /// Global latitude/longitude/altitude estimate with ENU velocity.
  GlobalPositionEstimate = 13,
  /// Combined pose, twist, covariance, and estimator quality sample.
  OdometryEstimate = 14,
  /// Estimator consistency metrics and accuracy estimates.
  EstimatorHealth = 15,
  /// Mission item progress and mission database identifiers.
  MissionProgress = 16,
  /// Current navigation target and tracking-error summary.
  NavigationTarget = 17,
  /// Home geodetic origin and corresponding local-frame reference.
  HomeReference = 18,
  /// Attitude setpoint with optional body-rate and thrust feed-forward.
  AttitudeCommand = 19,
  /// Body-rate setpoint with thrust feed-forward.
  RateCommand = 20,
  /// Local ENU position/velocity/acceleration/yaw setpoint.
  LocalPositionCommand = 21,
  /// Fixed-layout Bezier or polynomial trajectory segment setpoint.
  TrajectorySegment = 22,
  /// Normalized actuator control request.
  ActuatorCommand = 23,
  /// Normalized actuator output feedback.
  ActuatorFeedback = 24,
  /// Raw PWM output pulse widths.
  PwmSignalOutputs = 25,
  /// Control-loop timing, overrun, and load telemetry.
  ControlLoopMetrics = 26,
  /// Human-readable status or diagnostic text.
  TextStatus = 27,
  /// Compact vehicle status aggregate for low-rate ground-control links.
  GcsStatus = 28,
  /// Fixed-layout external pose and twist measurement for estimator input.
  ExternalOdometry = 29,
  /// Optional fixed-layout covariance companion for external odometry.
  ExternalOdometryCovariance = 30,
  /// Raw motion-capture marker and rigid-body samples for logging and tooling.
  MocapFrame = 31,
  /// Deterministic simulation barrier telling a receiver which boot time to reach.
  LockstepTick = 32,
  /// Deterministic simulation participant status and tick completion acknowledgement.
  LockstepStatus = 33,
  /// Firmware image transfer, verification, and activation progress.
  FirmwareProgress = 34,
  /// Unfiltered position and quaternion attitude measurement.
  RawPose = 35,
  /// Filtered position and quaternion attitude sample.
  Pose = 36,
  /// Filtered pose sample with 6x6 tangent covariance.
  PoseWithCovariance = 37,
  /// Filter-derived linear and angular velocity sample.
  Twist = 38,
  /// Filter-derived twist sample with 6x6 covariance.
  TwistWithCovariance = 39,
  /// Compact combined pose, twist, and estimator status.
  Odometry = 40,
  /// Odometry with complete 12x12 state covariance.
  OdometryWithCovariance = 41,
  /// Raw motion-capture frame with quaternion rigid-body attitudes.
  MocapPoseFrame = 42,
}
