include "types.fbs";

namespace synapse.topic;

/// Coefficient interpretation for a trajectory segment.
enum TrajectoryType:ubyte {
  /// Trajectory interpretation is not reported.
  Unknown = 0,
  /// Coefficients are Bezier control points.
  Bezier = 1,
  /// Coefficients are polynomial coefficients.
  Polynomial = 2,
}

/// Polynomial or Bezier degree represented by a trajectory segment.
enum TrajectoryDegree:ubyte {
  /// Degree is not reported.
  Unknown = 0,
  /// Degree 3 segment with p0 through p3 used.
  Cubic = 3,
  /// Degree 5 segment with p0 through p5 used.
  Quintic = 5,
  /// Degree 7 segment with p0 through p7 used.
  Septic = 7,
}

/// Validity and transfer behavior bits for TrajectorySegmentData.
enum TrajectorySegmentFlags:ushort (bit_flags) {
  /// Segment starts a new trajectory revision.
  Start,
  /// Segment is the final segment in the trajectory revision.
  Final,
  /// Receiver should discard older segments for this trajectory before applying this one.
  Replace,
  /// The yaw coefficient fields are meaningful.
  YawValid,
}

/// Fixed-layout segment for high-rate trajectory exchange. Lower-degree
/// trajectories ignore the higher-index coefficient fields.
struct TrajectorySegmentData {
  /// Publication timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Trajectory segment start time in the producer's monotonic boot time.
  start_time_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Position control point or polynomial coefficient 0 in local ENU meters.
  p0_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Position control point or polynomial coefficient 1 in local ENU meters.
  p1_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Position control point or polynomial coefficient 2 in local ENU meters.
  p2_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Position control point or polynomial coefficient 3 in local ENU meters.
  p3_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Position control point or polynomial coefficient 4 in local ENU meters.
  p4_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Position control point or polynomial coefficient 5 in local ENU meters.
  p5_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Position control point or polynomial coefficient 6 in local ENU meters.
  p6_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Position control point or polynomial coefficient 7 in local ENU meters.
  p7_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Yaw control point or polynomial coefficient 0 in radians.
  yaw0_rad:float (unit: "rad");
  /// Yaw control point or polynomial coefficient 1 in radians.
  yaw1_rad:float (unit: "rad");
  /// Yaw control point or polynomial coefficient 2 in radians.
  yaw2_rad:float (unit: "rad");
  /// Yaw control point or polynomial coefficient 3 in radians.
  yaw3_rad:float (unit: "rad");
  /// Yaw control point or polynomial coefficient 4 in radians.
  yaw4_rad:float (unit: "rad");
  /// Yaw control point or polynomial coefficient 5 in radians.
  yaw5_rad:float (unit: "rad");
  /// Yaw control point or polynomial coefficient 6 in radians.
  yaw6_rad:float (unit: "rad");
  /// Yaw control point or polynomial coefficient 7 in radians.
  yaw7_rad:float (unit: "rad");
  /// Trajectory stream or plan identifier.
  trajectory_id:uint;
  /// Segment sequence number within the trajectory revision.
  segment_seq:uint;
  /// Segment duration.
  duration_us:uint (unit: "s", scale: "1e-6", min: "0");
  /// Monotonic trajectory revision identifier.
  plan_version:uint;
  /// Bitmask of TrajectorySegmentFlags bits.
  flags:ushort;
  /// Bezier or polynomial coefficient interpretation.
  trajectory_type:TrajectoryType;
  /// Highest coefficient index used by this segment.
  degree:TrajectoryDegree;
  /// Local frame for position control points or coefficients.
  frame:synapse.types.LocalFrame;
  /// Optional topic instance identifier for multiple trajectory streams.
  id:ubyte;
}

/// FlatBuffers root wrapper for TrajectorySegmentData.
table TrajectorySegment {
  /// Fixed-layout trajectory segment payload.
  data:TrajectorySegmentData;
}
