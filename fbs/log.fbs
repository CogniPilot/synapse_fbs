namespace synapse.log;

// Header record written once near the start of a Synapse log.
table LogFileHeader {
  format_version:uint; // Log container format version.
  created_unix_us:ulong; // Unix timestamp when the log was created.
  source:string; // System, vehicle, or application that created the log.
  description:string; // Human-readable log description or run metadata.
}

// Schema definition record used to decode later topic payloads.
table SchemaRecord {
  schema_id:ulong; // Stable identifier referenced by TopicRecord.
  name:string; // Human-readable schema name.
  root_type:string; // FlatBuffers root type for payloads using this schema.
  file_id:string; // FlatBuffers file identifier when the schema defines one.
  fbs_text:string; // Source schema text for inspection and regeneration.
  fbs_sha256:string; // SHA-256 digest of fbs_text.
  bfbs:[ubyte]; // Binary FlatBuffers reflection schema.
}

// Topic definition record mapping a stream name/id to a schema.
table TopicRecord {
  topic_id:uint; // Numeric topic identifier used by LogFrame.
  name:string; // Human-readable topic name.
  schema_id:ulong; // SchemaRecord identifier used to decode this topic.
  encoding:string; // Payload encoding name, such as flatbuffers.
}

// Logged payload frame for one topic sample.
table LogFrame {
  monotonic_us:ulong; // Sample timestamp in monotonic boot time.
  topic_id:uint; // TopicRecord identifier for the payload.
  payload:[ubyte]; // Encoded payload bytes.
}

// Union of record types stored in a Synapse log.
union RecordPayload {
  LogFileHeader, // Log container metadata.
  SchemaRecord, // Schema definition for decoding topic payloads.
  TopicRecord, // Topic metadata and schema binding.
  LogFrame // Encoded topic sample.
}

// Root wrapper for any Synapse log record.
table LogRecord {
  record:RecordPayload; // Discriminated log record payload.
}

root_type LogRecord;
file_identifier "SYLG";
