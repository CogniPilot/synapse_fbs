include "types.fbs";

namespace synapse.topic;

/// Axis-validity bits for ManualControlData.active_axes.
enum ManualControlAxes:ushort (bit_flags) {
  /// pitch_milli is meaningful.
  Pitch,
  /// roll_milli is meaningful.
  Roll,
  /// throttle_milli is meaningful.
  Throttle,
  /// yaw_milli is meaningful.
  Yaw,
  /// aux0_milli is meaningful.
  Aux0,
  /// aux1_milli is meaningful.
  Aux1,
  /// aux2_milli is meaningful.
  Aux2,
  /// aux3_milli is meaningful.
  Aux3,
  /// aux4_milli is meaningful.
  Aux4,
  /// aux5_milli is meaningful.
  Aux5,
}

/// Switch and validity bits for ManualControlData.flags.
enum ManualControlFlags:ubyte (bit_flags) {
  /// The pilot arm switch is in the arm position.
  ArmSwitch,
  /// The pilot kill switch requests immediate output inhibition.
  KillSwitch,
  /// Manual input is currently selected or influencing control.
  Active,
  /// The manual input sample is fresh and passed validation.
  Valid,
}

/// Ignore bits for AttitudeCommandData.type_mask.
enum AttitudeCommandMask:ubyte (bit_flags) {
  /// Ignore the attitude quaternion.
  IgnoreAttitude,
  /// Ignore the roll body-rate feed-forward.
  IgnoreRateRoll,
  /// Ignore the pitch body-rate feed-forward.
  IgnoreRatePitch,
  /// Ignore the yaw body-rate feed-forward.
  IgnoreRateYaw,
  /// Ignore the thrust field.
  IgnoreThrust,
}

/// Ignore bits for RateCommandData.type_mask.
enum RateCommandMask:ubyte (bit_flags) {
  /// Ignore the roll rate setpoint.
  IgnoreRateRoll,
  /// Ignore the pitch rate setpoint.
  IgnoreRatePitch,
  /// Ignore the yaw rate setpoint.
  IgnoreRateYaw,
  /// Ignore the thrust field.
  IgnoreThrust,
}

/// Ignore and interpretation bits for LocalPositionCommandData.type_mask.
enum LocalPositionCommandMask:ushort (bit_flags) {
  /// Ignore the X position setpoint.
  IgnorePositionX,
  /// Ignore the Y position setpoint.
  IgnorePositionY,
  /// Ignore the Z position setpoint.
  IgnorePositionZ,
  /// Ignore the X velocity setpoint.
  IgnoreVelocityX,
  /// Ignore the Y velocity setpoint.
  IgnoreVelocityY,
  /// Ignore the Z velocity setpoint.
  IgnoreVelocityZ,
  /// Ignore the X acceleration setpoint.
  IgnoreAccelerationX,
  /// Ignore the Y acceleration setpoint.
  IgnoreAccelerationY,
  /// Ignore the Z acceleration setpoint.
  IgnoreAccelerationZ,
  /// Interpret the acceleration fields as force instead of acceleration.
  ForceSetpoint,
  /// Ignore the yaw setpoint.
  IgnoreYaw,
  /// Ignore the yaw-rate setpoint.
  IgnoreYawRate,
}

/// Raw receiver channel sample before pilot-input normalization. This is a
/// raw-layer topic: channel values are the receiver's native pulse widths.
struct RadioControlData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Number of valid channels in this sample, starting at channel 0.
  channel_count:ubyte;
  /// Receiver link quality from 0 to 100.
  link_quality_pct:ubyte (unit: "%", min: "0", max: "100");
  /// Raw channel 0 pulse width.
  chan0_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 1 pulse width.
  chan1_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 2 pulse width.
  chan2_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 3 pulse width.
  chan3_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 4 pulse width.
  chan4_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 5 pulse width.
  chan5_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 6 pulse width.
  chan6_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 7 pulse width.
  chan7_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 8 pulse width.
  chan8_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 9 pulse width.
  chan9_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 10 pulse width.
  chan10_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 11 pulse width.
  chan11_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 12 pulse width.
  chan12_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 13 pulse width.
  chan13_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 14 pulse width.
  chan14_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 15 pulse width.
  chan15_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 16 pulse width.
  chan16_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// Raw channel 17 pulse width.
  chan17_raw_us:ushort (unit: "s", scale: "1e-6", min: "0");
}

/// Normalized pilot intent after receiver decoding, mapping, and validity
/// checks. Axis fields use the full range -1000 to 1000. Throttle semantics
/// are fixed by the schema: negative values command reverse thrust or descent;
/// unidirectional vehicles clamp negative throttle to zero. Axis validity is
/// carried only by active_axes; there are no sentinel values.
struct ManualControlData {
  /// Command timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Bitmask of active momentary buttons or switches, indexed from bit 0.
  buttons:uint;
  /// Bitmask of ManualControlAxes bits indicating meaningful axes.
  active_axes:ushort;
  /// Pitch command in milli-units over -1000 to 1000; positive pitches nose up.
  pitch_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Roll command in milli-units over -1000 to 1000; positive rolls right.
  roll_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Throttle command in milli-units over -1000 to 1000; negative means reverse or descend.
  throttle_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Yaw command in milli-units over -1000 to 1000; positive yaws counter-clockwise.
  yaw_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Auxiliary axis 0 in milli-units over -1000 to 1000.
  aux0_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Auxiliary axis 1 in milli-units over -1000 to 1000.
  aux1_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Auxiliary axis 2 in milli-units over -1000 to 1000.
  aux2_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Auxiliary axis 3 in milli-units over -1000 to 1000.
  aux3_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Auxiliary axis 4 in milli-units over -1000 to 1000.
  aux4_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Auxiliary axis 5 in milli-units over -1000 to 1000.
  aux5_milli:short (unit: "1", scale: "1e-3", min: "-1", max: "1");
  /// Producer-defined requested flight mode.
  flight_mode:ubyte;
  /// Bitmask of ManualControlFlags bits.
  flags:ubyte;
}

/// Attitude setpoint with optional angular-rate and thrust feed-forward.
struct AttitudeCommandData {
  /// Command timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Desired orientation rotating body FLU vectors into the ENU world frame.
  attitude:synapse.types.Quaternionf (logical_type: "quaternion_flu_to_enu");
  /// Body-rate feed-forward in the FLU frame.
  body_rate_flu_rad_s:synapse.types.RateTriplet (unit: "rad/s", frame: "flu");
  /// Normalized collective thrust command over 0 to 1, or -1 to 1 for reverse-capable vehicles.
  thrust:float (unit: "1", min: "-1", max: "1");
  /// Bitmask of AttitudeCommandMask bits for ignored fields.
  type_mask:ubyte;
}

/// Body-rate setpoint with optional thrust feed-forward.
struct RateCommandData {
  /// Command timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Desired body angular rates in the FLU frame.
  body_rate_flu_rad_s:synapse.types.RateTriplet (unit: "rad/s", frame: "flu");
  /// Normalized collective thrust command over 0 to 1, or -1 to 1 for reverse-capable vehicles.
  thrust:float (unit: "1", min: "-1", max: "1");
  /// Bitmask of RateCommandMask bits for ignored fields.
  type_mask:ubyte;
}

/// Local-frame position, velocity, acceleration, and yaw setpoint.
struct LocalPositionCommandData {
  /// Command timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Desired local position in the ENU frame.
  position_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Desired local velocity in the ENU frame.
  velocity_enu_m_s:synapse.types.Vec3f (unit: "m/s", frame: "enu");
  /// Desired ENU acceleration in m/s^2, or force in newtons when ForceSetpoint is set.
  acceleration_or_force_enu:synapse.types.Vec3f;
  /// Desired yaw angle; zero east and positive counter-clockwise.
  yaw_rad:float (unit: "rad");
  /// Desired yaw rate; positive counter-clockwise.
  yaw_rate_rad_s:float (unit: "rad/s");
  /// Bitmask of LocalPositionCommandMask bits.
  type_mask:ushort;
  /// Frame in which the setpoint is expressed.
  coordinate_frame:synapse.types.LocalFrame;
}

/// Normalized actuator command for up to sixteen logical actuator controls.
struct ActuatorCommandData {
  /// Command timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Bitmask indicating which control slots are valid, indexed from bit 0.
  active_mask:uint;
  /// Normalized actuator control slot 0.
  control0:float (unit: "1");
  /// Normalized actuator control slot 1.
  control1:float (unit: "1");
  /// Normalized actuator control slot 2.
  control2:float (unit: "1");
  /// Normalized actuator control slot 3.
  control3:float (unit: "1");
  /// Normalized actuator control slot 4.
  control4:float (unit: "1");
  /// Normalized actuator control slot 5.
  control5:float (unit: "1");
  /// Normalized actuator control slot 6.
  control6:float (unit: "1");
  /// Normalized actuator control slot 7.
  control7:float (unit: "1");
  /// Normalized actuator control slot 8.
  control8:float (unit: "1");
  /// Normalized actuator control slot 9.
  control9:float (unit: "1");
  /// Normalized actuator control slot 10.
  control10:float (unit: "1");
  /// Normalized actuator control slot 11.
  control11:float (unit: "1");
  /// Normalized actuator control slot 12.
  control12:float (unit: "1");
  /// Normalized actuator control slot 13.
  control13:float (unit: "1");
  /// Normalized actuator control slot 14.
  control14:float (unit: "1");
  /// Normalized actuator control slot 15.
  control15:float (unit: "1");
}

/// Normalized actuator feedback for up to thirty-two physical outputs. The
/// command message carries sixteen logical controls while feedback covers
/// thirty-two physical outputs after mixing and allocation.
struct ActuatorFeedbackData {
  /// Feedback timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Bitmask indicating which output slots are valid, indexed from bit 0.
  active_mask:uint;
  /// Normalized actuator output slot 0.
  output0:float (unit: "1");
  /// Normalized actuator output slot 1.
  output1:float (unit: "1");
  /// Normalized actuator output slot 2.
  output2:float (unit: "1");
  /// Normalized actuator output slot 3.
  output3:float (unit: "1");
  /// Normalized actuator output slot 4.
  output4:float (unit: "1");
  /// Normalized actuator output slot 5.
  output5:float (unit: "1");
  /// Normalized actuator output slot 6.
  output6:float (unit: "1");
  /// Normalized actuator output slot 7.
  output7:float (unit: "1");
  /// Normalized actuator output slot 8.
  output8:float (unit: "1");
  /// Normalized actuator output slot 9.
  output9:float (unit: "1");
  /// Normalized actuator output slot 10.
  output10:float (unit: "1");
  /// Normalized actuator output slot 11.
  output11:float (unit: "1");
  /// Normalized actuator output slot 12.
  output12:float (unit: "1");
  /// Normalized actuator output slot 13.
  output13:float (unit: "1");
  /// Normalized actuator output slot 14.
  output14:float (unit: "1");
  /// Normalized actuator output slot 15.
  output15:float (unit: "1");
  /// Normalized actuator output slot 16.
  output16:float (unit: "1");
  /// Normalized actuator output slot 17.
  output17:float (unit: "1");
  /// Normalized actuator output slot 18.
  output18:float (unit: "1");
  /// Normalized actuator output slot 19.
  output19:float (unit: "1");
  /// Normalized actuator output slot 20.
  output20:float (unit: "1");
  /// Normalized actuator output slot 21.
  output21:float (unit: "1");
  /// Normalized actuator output slot 22.
  output22:float (unit: "1");
  /// Normalized actuator output slot 23.
  output23:float (unit: "1");
  /// Normalized actuator output slot 24.
  output24:float (unit: "1");
  /// Normalized actuator output slot 25.
  output25:float (unit: "1");
  /// Normalized actuator output slot 26.
  output26:float (unit: "1");
  /// Normalized actuator output slot 27.
  output27:float (unit: "1");
  /// Normalized actuator output slot 28.
  output28:float (unit: "1");
  /// Normalized actuator output slot 29.
  output29:float (unit: "1");
  /// Normalized actuator output slot 30.
  output30:float (unit: "1");
  /// Normalized actuator output slot 31.
  output31:float (unit: "1");
}

/// Raw PWM pulse-width outputs for servo and ESC drivers.
struct PwmSignalOutputsData {
  /// Output timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Bitmask indicating which PWM outputs are valid, indexed from bit 0.
  active_mask:uint;
  /// Producer-defined output bank or timer port.
  port:ubyte;
  /// PWM output 0 pulse width.
  output0_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 1 pulse width.
  output1_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 2 pulse width.
  output2_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 3 pulse width.
  output3_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 4 pulse width.
  output4_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 5 pulse width.
  output5_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 6 pulse width.
  output6_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 7 pulse width.
  output7_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 8 pulse width.
  output8_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 9 pulse width.
  output9_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 10 pulse width.
  output10_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 11 pulse width.
  output11_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 12 pulse width.
  output12_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 13 pulse width.
  output13_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 14 pulse width.
  output14_us:ushort (unit: "s", scale: "1e-6", min: "0");
  /// PWM output 15 pulse width.
  output15_us:ushort (unit: "s", scale: "1e-6", min: "0");
}

/// Runtime metrics for a control loop or scheduler slice.
struct ControlLoopMetricsData {
  /// Metrics timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Measured loop period.
  period_us:uint (unit: "s", scale: "1e-6", min: "0");
  /// Time from scheduled release to completion or publication.
  latency_us:uint (unit: "s", scale: "1e-6", min: "0");
  /// Cumulative count of missed deadlines.
  overrun_count:uint;
  /// Loop load as deci-percent, where 1000 means 100%.
  load_dpermille:ushort (unit: "1", scale: "1e-3", min: "0");
}

/// FlatBuffers root wrapper for RadioControlData.
table RadioControl {
  /// Fixed-layout raw receiver payload.
  data:RadioControlData;
}

/// FlatBuffers root wrapper for ManualControlData.
table ManualControlCommand {
  /// Fixed-layout manual-control payload.
  data:ManualControlData;
}

/// FlatBuffers root wrapper for AttitudeCommandData.
table AttitudeCommand {
  /// Fixed-layout attitude-command payload.
  data:AttitudeCommandData;
}

/// FlatBuffers root wrapper for RateCommandData.
table RateCommand {
  /// Fixed-layout rate-command payload.
  data:RateCommandData;
}

/// FlatBuffers root wrapper for LocalPositionCommandData.
table LocalPositionCommand {
  /// Fixed-layout local-position-command payload.
  data:LocalPositionCommandData;
}

/// FlatBuffers root wrapper for ActuatorCommandData.
table ActuatorCommand {
  /// Fixed-layout actuator-command payload.
  data:ActuatorCommandData;
}

/// FlatBuffers root wrapper for ActuatorFeedbackData.
table ActuatorFeedback {
  /// Fixed-layout actuator-feedback payload.
  data:ActuatorFeedbackData;
}

/// FlatBuffers root wrapper for PwmSignalOutputsData.
table PwmSignalOutputs {
  /// Fixed-layout PWM output payload.
  data:PwmSignalOutputsData;
}

/// FlatBuffers root wrapper for ControlLoopMetricsData.
table ControlLoopMetrics {
  /// Fixed-layout control-loop metrics payload.
  data:ControlLoopMetricsData;
}
