  px30_lsb:float; // Pixel 30 amplitude in LSB.
  px31_lsb:float; // Pixel 31 amplitude in LSB.
}

// Per-pixel status bytes for the 32-zone AFBR-S50 field.
struct ArgusPixelStatus32 {
  px0:ubyte; // Pixel 0 ArgusPixelStatusFlags bits.
  px1:ubyte; // Pixel 1 ArgusPixelStatusFlags bits.
  px2:ubyte; // Pixel 2 ArgusPixelStatusFlags bits.
  px3:ubyte; // Pixel 3 ArgusPixelStatusFlags bits.
  px4:ubyte; // Pixel 4 ArgusPixelStatusFlags bits.
  px5:ubyte; // Pixel 5 ArgusPixelStatusFlags bits.
  px6:ubyte; // Pixel 6 ArgusPixelStatusFlags bits.
  px7:ubyte; // Pixel 7 ArgusPixelStatusFlags bits.
  px8:ubyte; // Pixel 8 ArgusPixelStatusFlags bits.
  px9:ubyte; // Pixel 9 ArgusPixelStatusFlags bits.
  px10:ubyte; // Pixel 10 ArgusPixelStatusFlags bits.
  px11:ubyte; // Pixel 11 ArgusPixelStatusFlags bits.
  px12:ubyte; // Pixel 12 ArgusPixelStatusFlags bits.
  px13:ubyte; // Pixel 13 ArgusPixelStatusFlags bits.
  px14:ubyte; // Pixel 14 ArgusPixelStatusFlags bits.
  px15:ubyte; // Pixel 15 ArgusPixelStatusFlags bits.
  px16:ubyte; // Pixel 16 ArgusPixelStatusFlags bits.
  px17:ubyte; // Pixel 17 ArgusPixelStatusFlags bits.
  px18:ubyte; // Pixel 18 ArgusPixelStatusFlags bits.
  px19:ubyte; // Pixel 19 ArgusPixelStatusFlags bits.
  px20:ubyte; // Pixel 20 ArgusPixelStatusFlags bits.
  px21:ubyte; // Pixel 21 ArgusPixelStatusFlags bits.
  px22:ubyte; // Pixel 22 ArgusPixelStatusFlags bits.
  px23:ubyte; // Pixel 23 ArgusPixelStatusFlags bits.
  px24:ubyte; // Pixel 24 ArgusPixelStatusFlags bits.
  px25:ubyte; // Pixel 25 ArgusPixelStatusFlags bits.
  px26:ubyte; // Pixel 26 ArgusPixelStatusFlags bits.
  px27:ubyte; // Pixel 27 ArgusPixelStatusFlags bits.
  px28:ubyte; // Pixel 28 ArgusPixelStatusFlags bits.
  px29:ubyte; // Pixel 29 ArgusPixelStatusFlags bits.
  px30:ubyte; // Pixel 30 ArgusPixelStatusFlags bits.
  px31:ubyte; // Pixel 31 ArgusPixelStatusFlags bits.
}

// Per-pixel time-of-flight point cloud from an AFBR-S50 (argus) ranger. Raw
// layer: ranges are sensor-native meters before mounting calibration, in the
// sensor frame; a consumer projects pixels through the sensor optics model
// and mounting pose. Amplitude is the per-pixel intensity. This topic is
// bandwidth heavy and meant for opt-in offboard streaming and logging; the
// fused scalar range rides on OpticalFlow.
struct ArgusPointCloudData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  range_m:ArgusPixelRanges32; // Per-pixel range in meters.
  amplitude_lsb:ArgusPixelAmplitudes32; // Per-pixel return amplitude in LSB.
  integration_time_us:uint; // Analog integration time of this frame in microseconds.
  pixel_enabled_mask:uint; // Device pixel-enable mask active for this frame.
  channel_enabled_mask:uint; // Device ADC channel-enable mask active for this frame.
  reference_range_m:float; // Internal reference pixel range in meters; a calibration aid, not scene geometry.
  reference_amplitude_lsb:float; // Internal reference pixel amplitude in LSB.
  device_status:short; // Device status for the frame: zero is OK, negative is a device error code.
  pixel_status:ArgusPixelStatus32; // Per-pixel ArgusPixelStatusFlags bits; zero marks a valid pixel.
  reference_status:ubyte; // ArgusPixelStatusFlags bits of the reference pixel.
  signal_quality:ubyte; // Overall signal quality percentage: 0 not available, 1 bad, 100 good.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
  id:ubyte; // Ranger instance identifier; also the instance segment of the Zenoh key.
}

// FlatBuffers root wrapper for ArgusPointCloudData.
table ArgusPointCloud {
  data:ArgusPointCloudData; // Fixed-layout point-cloud payload.
}
