  px12_lsb:float; // Pixel 12 amplitude in LSB.
  px13_lsb:float; // Pixel 13 amplitude in LSB.
  px14_lsb:float; // Pixel 14 amplitude in LSB.
  px15_lsb:float; // Pixel 15 amplitude in LSB.
  px16_lsb:float; // Pixel 16 amplitude in LSB.
  px17_lsb:float; // Pixel 17 amplitude in LSB.
  px18_lsb:float; // Pixel 18 amplitude in LSB.
  px19_lsb:float; // Pixel 19 amplitude in LSB.
  px20_lsb:float; // Pixel 20 amplitude in LSB.
