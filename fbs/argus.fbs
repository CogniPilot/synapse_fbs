include "types.fbs";

namespace synapse.topic;

// Per-pixel result status bits for the AFBR-S50 time-of-flight imager,
// mirroring the sensor SDK pixel status word. A zero value marks a fully
// valid pixel measurement.
enum ArgusPixelStatusFlags:ubyte (bit_flags) {
  Off, // Pixel is disabled by the pixel-enable mask.
  Saturated, // Pixel saturated; range and amplitude are unreliable.
  BinningExcluded, // Pixel was excluded from the 1D binned result.
  Invalid, // Pixel result is invalid.
  Prefiltered, // Pixel was discarded by the static prefilter.
  NoSignal, // Pixel has no detectable return signal.
  OutOfSync, // Pixel lost measurement synchronization.
  Stalled, // Pixel processing stalled.
}

// Per-pixel ranges for the 32-zone AFBR-S50 field, in device pixel order.
// Disabled or invalid pixels carry their last computed value; consult the
// matching status byte before using a pixel.
struct ArgusPixelRanges32 {
  px0_m:float; // Pixel 0 range in meters.
  px1_m:float; // Pixel 1 range in meters.
  px2_m:float; // Pixel 2 range in meters.
  px3_m:float; // Pixel 3 range in meters.
  px4_m:float; // Pixel 4 range in meters.
  px5_m:float; // Pixel 5 range in meters.
  px6_m:float; // Pixel 6 range in meters.
  px7_m:float; // Pixel 7 range in meters.
  px8_m:float; // Pixel 8 range in meters.
  px9_m:float; // Pixel 9 range in meters.
  px10_m:float; // Pixel 10 range in meters.
  px11_m:float; // Pixel 11 range in meters.
  px12_m:float; // Pixel 12 range in meters.
  px13_m:float; // Pixel 13 range in meters.
  px14_m:float; // Pixel 14 range in meters.
  px15_m:float; // Pixel 15 range in meters.
  px16_m:float; // Pixel 16 range in meters.
  px17_m:float; // Pixel 17 range in meters.
  px18_m:float; // Pixel 18 range in meters.
  px19_m:float; // Pixel 19 range in meters.
  px20_m:float; // Pixel 20 range in meters.
  px21_m:float; // Pixel 21 range in meters.
  px22_m:float; // Pixel 22 range in meters.
  px23_m:float; // Pixel 23 range in meters.
  px24_m:float; // Pixel 24 range in meters.
  px25_m:float; // Pixel 25 range in meters.
  px26_m:float; // Pixel 26 range in meters.
  px27_m:float; // Pixel 27 range in meters.
  px28_m:float; // Pixel 28 range in meters.
  px29_m:float; // Pixel 29 range in meters.
  px30_m:float; // Pixel 30 range in meters.
  px31_m:float; // Pixel 31 range in meters.
}

// Per-pixel return amplitudes for the 32-zone AFBR-S50 field: the intensity
// channel of the point cloud, in sensor LSB.
struct ArgusPixelAmplitudes32 {
