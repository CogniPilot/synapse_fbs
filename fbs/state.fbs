include "types.fbs";

namespace synapse.topic;

/// Sensor and subsystem bits for the VehicleHealthData sensor bitmasks.
enum SensorComponentFlags:uint (bit_flags) {
  /// Angular-rate sensing.
  Gyro,
  /// Linear-acceleration sensing.
  Accel,
  /// Magnetic field sensing.
  Mag,
  /// Static pressure sensing.
  AbsolutePressure,
  /// Differential pressure sensing.
  DifferentialPressure,
  /// Global navigation satellite receiver.
  Gnss,
  /// Optical-flow sensing.
  OpticalFlow,
  /// Vision or motion-capture positioning input.
  VisionPosition,
  /// Distance-to-surface sensing.
  Rangefinder,
  /// Manual receiver input.
  RadioControl,
  /// Actuator and motor output path.
  MotorOutputs,
  /// Battery monitoring.
  Battery,
  /// State estimator.
  Estimator,
  /// Onboard logging.
  Logging,
  /// Command and telemetry link.
  CommandLink,
  /// Terrain database or terrain following.
  Terrain,
}

/// Vehicle-level status bits for VehicleHealthData.flags.
enum VehicleHealthFlags:ubyte (bit_flags) {
  /// Actuators are allowed to produce motion.
  Armed,
  /// An active failsafe is affecting vehicle behavior.
  Failsafe,
}

/// Field-validity bits for AttitudeEstimateData.flags.
enum AttitudeEstimateFlags:ubyte (bit_flags) {
  /// The attitude quaternion is usable.
  AttitudeValid,
  /// The angular-velocity fields are usable.
  RatesValid,
}

/// Field-validity bits for LocalPositionEstimateData.flags.
enum LocalPositionFlags:ubyte (bit_flags) {
  /// Horizontal position is valid.
  XyValid,
  /// Vertical position is valid.
  ZValid,
  /// Horizontal velocity is valid.
  VxyValid,
  /// Vertical velocity is valid.
  VzValid,
}

/// Field-validity bits for ExternalOdometryData.flags.
enum ExternalOdometryFlags:ubyte (bit_flags) {
  /// position_enu_m is meaningful.
  PositionValid,
  /// attitude is meaningful.
  AttitudeValid,
  /// linear_velocity_enu_m_s is meaningful.
  LinearVelocityValid,
  /// angular_velocity_flu_rad_s is meaningful.
  AngularVelocityValid,
  /// State was predicted without a current accepted mocap correction.
  Extrapolated,
  /// A current mocap update was rejected by innovation gates.
  OutlierRejected,
  /// State is usable but tracking quality or uncertainty is degraded.
  Degraded,
  /// State should not be used for navigation.
  Lost,
}

/// Quality/status state for external odometry producer output.
enum ExternalOdometryStatus:ubyte {
  /// Producer did not report a quality/status state.
  Unknown = 0,
  /// Current mocap update was accepted into the estimate.
  Filtered = 1,
  /// Short prediction-only gap after the last accepted mocap update.
  ExtrapolatedShort = 2,
  /// Extended prediction-only gap; downstream users should degrade behavior.
  ExtrapolatedLong = 3,
  /// Extrapolation exceeded the producer's safe limit.
  Lost = 4,
  /// Current mocap update was rejected and the state was predicted.
  OutlierRejected = 5,
  /// Current mocap update was accepted but quality is reduced.
  Degraded = 6,
}

/// Field-validity and estimator-state bits for OdometryData and
/// OdometryWithCovarianceData.
enum OdometryFlags:ubyte (bit_flags) {
  /// pose.position_enu_m is meaningful.
  PositionValid,
  /// pose.attitude is meaningful.
  AttitudeValid,
  /// twist.linear_velocity_enu_m_s is meaningful.
  LinearVelocityValid,
  /// twist.angular_velocity_flu_rad_s is meaningful.
  AngularVelocityValid,
  /// State was predicted without a current accepted correction.
  Extrapolated,
  /// A current measurement was rejected by innovation gates.
  OutlierRejected,
  /// State is usable but tracking quality or uncertainty is degraded.
  Degraded,
  /// State should not be used for navigation.
  Lost,
}

/// Quality/status state for a producer-side odometry estimate.
enum OdometryStatus:ubyte {
  /// Producer did not report a quality/status state.
  Unknown = 0,
  /// Current measurement was accepted into the estimate.
  Filtered = 1,
  /// Short prediction-only gap after the last accepted measurement.
  ExtrapolatedShort = 2,
  /// Extended prediction-only gap; downstream users should degrade behavior.
  ExtrapolatedLong = 3,
  /// Extrapolation exceeded the producer's safe limit.
  Lost = 4,
  /// Current measurement was rejected and the state was predicted.
  OutlierRejected = 5,
  /// Current measurement was accepted but quality is reduced.
  Degraded = 6,
}

/// Field-validity bits for GlobalPositionEstimateData.flags.
enum GlobalPositionFlags:ubyte (bit_flags) {
  /// The global position estimate is usable for navigation.
  Valid,
  /// The yaw estimate is usable.
  YawValid,
}

/// Field-validity bits for HomeReferenceData.flags.
enum HomeReferenceFlags:ubyte (bit_flags) {
  /// Geodetic and local home positions are valid.
  PositionValid,
  /// The home alignment quaternion is valid.
  AttitudeValid,
  /// The approach vector is valid.
  ApproachValid,
}

/// Vehicle-wide state summary for operator displays and failsafe supervision.
struct VehicleHealthData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Bitmask of SensorComponentFlags bits for detected components.
  sensors_present:uint;
  /// Bitmask of SensorComponentFlags bits enabled for use.
  sensors_enabled:uint;
  /// Bitmask of SensorComponentFlags bits currently considered healthy.
  sensors_health:uint;
  /// Reserved extension bitmask for future component bits.
  sensors_present_ext:uint;
  /// Reserved extension bitmask for future component bits.
  sensors_enabled_ext:uint;
  /// Reserved extension bitmask for future component bits.
  sensors_health_ext:uint;
  /// Main controller load as deci-percent, where 1000 means 100%.
  load_dpermille:ushort (unit: "1", scale: "1e-3", min: "0");
  /// Primary battery pack voltage in centi-volts.
  voltage_battery_cv:ushort (unit: "V", scale: "1e-2", min: "0");
  /// Primary battery current in deci-amps; positive means discharge.
  current_battery_da:short (unit: "A", scale: "1e-1");
  /// Communication drop rate as centi-percent.
  drop_rate_comm_cpercent:ushort (unit: "%", scale: "1e-2", min: "0", max: "100");
  /// Communication error count.
  errors_comm:ushort;
  /// Remaining primary battery percentage, or negative when unknown.
  battery_remaining_pct:byte (unit: "%", min: "0", max: "100", valid_if: "value >= 0");
  /// Producer-defined vehicle class.
  vehicle_type:ubyte;
  /// Producer-defined active flight mode.
  flight_mode:ubyte;
  /// Producer-defined high-level system state.
  system_state:ubyte;
  /// Command/control link quality from 0 to 100.
  link_quality_pct:ubyte (unit: "%", min: "0", max: "100");
  /// Bitmask of VehicleHealthFlags bits.
  flags:ubyte;
}

/// Pairing between Unix time and monotonic boot time.
struct TimeReferenceData {
  /// Unix epoch timestamp corresponding to time_boot_us.
  time_unix_us:ulong (unit: "s", clock: "unix_epoch", scale: "1e-6", min: "0");
  /// Monotonic boot timestamp at which time_unix_us was sampled.
  time_boot_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
}

/// Attitude estimate and angular velocity from the active estimator. The
/// quaternion is the only attitude representation on the wire; consumers
/// derive Euler angles locally when needed for display.
struct AttitudeEstimateData {
  /// Estimate timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Orientation rotating body FLU vectors into the ENU world frame.
  attitude:synapse.types.Quaternionf (logical_type: "quaternion_flu_to_enu");
  /// Body angular velocity in the FLU frame.
  angular_velocity_flu_rad_s:synapse.types.RateTriplet (unit: "rad/s", frame: "flu");
  /// Bitmask of AttitudeEstimateFlags bits.
  flags:ubyte;
}

/// Local-frame position estimate for navigation and control.
struct LocalPositionEstimateData {
  /// Estimate timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Local position relative to the active local origin.
  position_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Local velocity in the ENU frame.
  velocity_enu_m_s:synapse.types.Vec3f (unit: "m/s", frame: "enu");
  /// Local acceleration in the ENU frame.
  acceleration_enu_m_s2:synapse.types.Vec3f (unit: "m/s2", frame: "enu");
  /// Heading angle; zero east and positive counter-clockwise.
  yaw_rad:float (unit: "rad", min: "-3.141592653589793", max: "3.141592653589793");
  /// Heading rate, positive counter-clockwise.
  yaw_rate_rad_s:float (unit: "rad/s");
  /// Bitmask of LocalPositionFlags bits.
  flags:ubyte;
  /// Increments when the estimator resets or jumps the horizontal state.
  xy_reset_counter:ubyte;
  /// Increments when the estimator resets or jumps the vertical state.
  z_reset_counter:ubyte;
}

/// Global geodetic position estimate with compact velocity and status fields.
struct GlobalPositionEstimateData {
  /// Estimate timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Latitude in WGS-84 degrees scaled by 1e7.
  latitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-90", max: "90");
  /// Longitude in WGS-84 degrees scaled by 1e7.
  longitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-180", max: "180");
  /// Height above mean sea level.
  altitude_msl_mm:int (unit: "m", scale: "1e-3");
  /// Height above the active home or local origin.
  relative_altitude_mm:int (unit: "m", scale: "1e-3");
  /// East component of global-frame velocity.
  velocity_east_cm_s:short (unit: "m/s", frame: "enu", scale: "1e-2");
  /// North component of global-frame velocity.
  velocity_north_cm_s:short (unit: "m/s", frame: "enu", scale: "1e-2");
  /// Up component of global-frame velocity.
  velocity_up_cm_s:short (unit: "m/s", frame: "enu", scale: "1e-2");
  /// Heading in the range -18000 to 18000; zero east and positive counter-clockwise per REP-0103.
  yaw_cdeg:short (unit: "deg", scale: "1e-2", min: "-180", max: "180");
  /// Producer-defined source identifier for this global estimate.
  source:ubyte;
  /// Bitmask of GlobalPositionFlags bits.
  flags:ubyte;
}

/// Combined pose, twist, covariance, and estimator metadata.
struct OdometryEstimateData {
  /// Estimate timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Local position in the ENU frame.
  position_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Orientation rotating body FLU vectors into the ENU world frame.
  attitude:synapse.types.Quaternionf (logical_type: "quaternion_flu_to_enu");
  /// Linear velocity in the ENU frame.
  velocity_enu_m_s:synapse.types.Vec3f (unit: "m/s", frame: "enu");
  /// Body angular velocity in the FLU frame.
  angular_velocity_flu_rad_s:synapse.types.RateTriplet (unit: "rad/s", frame: "flu");
  /// Upper-triangular covariance for position and orientation.
  pose_covariance:synapse.types.CovarianceUpperTriangle21f;
  /// Upper-triangular covariance for linear and angular velocity.
  velocity_covariance:synapse.types.CovarianceUpperTriangle21f;
  /// Increments when the estimator resets or jumps the state.
  reset_counter:ubyte;
  /// Producer-defined estimator implementation identifier.
  estimator_type:ubyte;
  /// Overall odometry quality percentage, or negative when unknown.
  quality_pct:byte (unit: "%", min: "0", max: "100", valid_if: "value >= 0");
}

/// Unfiltered six-degree-of-freedom source pose measurement. Raw pose has no
/// covariance unless the source reports one through a future dedicated type.
struct RawPoseData {
  /// Source measurement timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Measured position and body-FLU-to-ENU quaternion attitude.
  pose:synapse.types.Posef;
}

/// Filtered six-degree-of-freedom pose sample without covariance.
struct PoseData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Position and body-FLU-to-ENU quaternion attitude.
  pose:synapse.types.Posef;
}

/// Pose sample with 6x6 tangent covariance ordered
/// [x, y, z, rotation_x, rotation_y, rotation_z].
struct PoseWithCovarianceData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Position and body-FLU-to-ENU quaternion attitude.
  pose:synapse.types.Posef;
  /// Upper-triangular pose covariance.
  covariance:synapse.types.CovarianceUpperTriangle21f;
}

/// Linear and angular velocity sample without covariance.
struct TwistData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// ENU linear velocity and body-FLU angular velocity.
  twist:synapse.types.Twistf;
}

/// Twist sample with 6x6 covariance ordered
/// [velocity_x, velocity_y, velocity_z, angular_x, angular_y, angular_z].
struct TwistWithCovarianceData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// ENU linear velocity and body-FLU angular velocity.
  twist:synapse.types.Twistf;
  /// Upper-triangular twist covariance.
  covariance:synapse.types.CovarianceUpperTriangle21f;
}

/// Compact combined pose, twist, and estimator metadata without covariance.
struct OdometryData {
  /// Estimate timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Estimated position and attitude.
  pose:synapse.types.Posef;
  /// Estimated linear and angular velocity.
  twist:synapse.types.Twistf;
  /// Bitmask of OdometryFlags bits.
  flags:OdometryFlags;
  /// Producer state quality and extrapolation status.
  status:OdometryStatus;
  /// Increments when the estimator resets or jumps the state.
  reset_counter:ubyte;
  /// Producer-defined estimator implementation identifier.
  estimator_type:ubyte;
  /// Overall odometry quality percentage, or negative when unknown.
  quality_pct:byte (unit: "%", min: "0", max: "100", valid_if: "value >= 0");
}

/// Odometry with the complete 12x12 tangent covariance, retaining pose-twist
/// cross-correlations. State order is [x, y, z, rotation_x, rotation_y,
/// rotation_z, velocity_x, velocity_y, velocity_z, angular_x, angular_y,
/// angular_z].
struct OdometryWithCovarianceData {
  /// Estimate timestamp matching the contained state.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Estimated position and attitude.
  pose:synapse.types.Posef;
  /// Estimated linear and angular velocity.
  twist:synapse.types.Twistf;
  /// Upper-triangular 12x12 state covariance.
  covariance:synapse.types.CovarianceUpperTriangle78f;
  /// Bitmask of OdometryFlags bits.
  flags:OdometryFlags;
  /// Producer state quality and extrapolation status.
  status:OdometryStatus;
  /// Increments when the estimator resets or jumps the state.
  reset_counter:ubyte;
  /// Producer-defined estimator implementation identifier.
  estimator_type:ubyte;
  /// Overall odometry quality percentage, or negative when unknown.
  quality_pct:byte (unit: "%", min: "0", max: "100", valid_if: "value >= 0");
}

/// External pose and twist measurement for estimator input. Pose is expressed
/// in local/world ENU. Linear velocity is ENU. Angular velocity is body FLU.
/// This is the compact high-rate path; uncertainty and estimator diagnostics
/// are opt-in companion topics.
struct ExternalOdometryData {
  /// Estimate timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Measured local/world position in ENU.
  position_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Measured orientation rotating body FLU vectors into ENU.
  attitude:synapse.types.Quaternionf (logical_type: "quaternion_flu_to_enu");
  /// Measured linear velocity in ENU.
  linear_velocity_enu_m_s:synapse.types.Vec3f (unit: "m/s", frame: "enu", valid_if: "flags.LinearVelocityValid");
  /// Measured angular velocity in body FLU.
  angular_velocity_flu_rad_s:synapse.types.RateTriplet (unit: "rad/s", frame: "flu", valid_if: "flags.AngularVelocityValid");
  /// Bitmask of ExternalOdometryFlags bits.
  flags:ExternalOdometryFlags;
  /// Producer state quality and extrapolation status.
  status:ExternalOdometryStatus;
  /// External source instance identifier.
  source_id:ubyte;
  /// Tracked rigid-body instance identifier; also the instance segment of the Zenoh key.
  id:ubyte;
}

/// Optional covariance companion for ExternalOdometryData. Publish this only when
/// consumers subscribe to the covariance topic or request estimator diagnostics;
/// the high-rate external odometry topic carries only pose/twist. The covariance
/// is over the 12D tangent state [theta, velocity, position, angular_velocity],
/// where theta is the attitude perturbation in the body-FLU tangent and
/// velocity/position are ENU.
struct ExternalOdometryCovarianceData {
  /// Estimate timestamp matching ExternalOdometryData.timestamp_us.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Upper-triangular covariance for the 12D tangent state.
  covariance:synapse.types.CovarianceUpperTriangle78f;
  /// External source instance identifier.
  source_id:ubyte;
  /// Tracked rigid-body instance identifier.
  id:ubyte;
}

/// Estimator health and innovation-test summary. The flags field is
/// deliberately producer-defined: estimator status models differ between
/// implementations and are standardized via discovery records, not the schema.
struct EstimatorHealthData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Producer-defined estimator status and fault bitmask.
  flags:ushort;
  /// Innovation test ratio for velocity observations.
  velocity_test_ratio:float (unit: "1", min: "0");
  /// Innovation test ratio for horizontal position observations.
  pos_horiz_test_ratio:float (unit: "1", min: "0");
  /// Innovation test ratio for vertical position observations.
  pos_vert_test_ratio:float (unit: "1", min: "0");
  /// Innovation test ratio for magnetic observations.
  mag_test_ratio:float (unit: "1", min: "0");
  /// Innovation test ratio for height-above-ground observations.
  hagl_test_ratio:float (unit: "1", min: "0");
  /// Innovation test ratio for true-airspeed observations.
  tas_test_ratio:float (unit: "1", min: "0");
  /// Estimated one-sigma horizontal position accuracy.
  pos_horiz_accuracy_m:float (unit: "m", min: "0");
  /// Estimated one-sigma vertical position accuracy.
  pos_vert_accuracy_m:float (unit: "m", min: "0");
}

/// Mission progress and mission database identifiers.
struct MissionProgressData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Identifier that changes when the mission plan changes.
  mission_id:uint;
  /// Identifier that changes when the geofence set changes.
  fence_id:uint;
  /// Identifier that changes when the rally-point set changes.
  rally_points_id:uint;
  /// Current mission item sequence number.
  current_seq:ushort;
  /// Total number of mission items known to the producer.
  total:ushort;
  /// Mission execution state.
  mission_state:synapse.types.MissionState;
  /// Producer-defined mission mode or mission type.
  mission_mode:ubyte;
}

/// Navigation controller target and tracking-error summary. Angles follow
/// REP-0103: zero east, positive counter-clockwise, range -18000 to 18000.
struct NavigationTargetData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Target altitude minus estimated altitude.
  altitude_error_m:float (unit: "m");
  /// Target airspeed minus estimated airspeed.
  airspeed_error_m_s:float (unit: "m/s");
  /// Cross-track error relative to the active path.
  xtrack_error_m:float (unit: "m");
  /// Roll angle requested by navigation.
  desired_roll_cdeg:short (unit: "deg", scale: "1e-2", min: "-180", max: "180");
  /// Pitch angle requested by navigation.
  desired_pitch_cdeg:short (unit: "deg", scale: "1e-2", min: "-180", max: "180");
  /// Navigation yaw command.
  desired_yaw_cdeg:short (unit: "deg", scale: "1e-2", min: "-180", max: "180");
  /// Yaw toward the active target.
  target_yaw_cdeg:short (unit: "deg", scale: "1e-2", min: "-180", max: "180");
  /// Remaining straight-line distance to the active waypoint.
  distance_to_waypoint_m:ushort (unit: "m", min: "0");
}

/// Home position and local-origin reference.
struct HomeReferenceData {
  /// Reference timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Home latitude in WGS-84 degrees scaled by 1e7.
  latitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-90", max: "90");
  /// Home longitude in WGS-84 degrees scaled by 1e7.
  longitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-180", max: "180");
  /// Home height above mean sea level.
  altitude_msl_mm:int (unit: "m", scale: "1e-3");
  /// Home position in the active local ENU frame.
  local_position_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Map-to-local alignment rotating FLU vectors at home into ENU.
  attitude:synapse.types.Quaternionf (logical_type: "quaternion_flu_to_enu");
  /// Preferred approach point or vector in the local ENU frame.
  approach_enu_m:synapse.types.Vec3f (unit: "m", frame: "enu");
  /// Bitmask of HomeReferenceFlags bits.
  flags:ubyte;
}

/// FlatBuffers root wrapper for VehicleHealthData.
table VehicleHealth {
  /// Fixed-layout vehicle-health payload.
  data:VehicleHealthData;
}

/// FlatBuffers root wrapper for TimeReferenceData.
table TimeReference {
  /// Fixed-layout time-reference payload.
  data:TimeReferenceData;
}

/// FlatBuffers root wrapper for AttitudeEstimateData.
table AttitudeEstimate {
  /// Fixed-layout attitude-estimate payload.
  data:AttitudeEstimateData;
}

/// FlatBuffers root wrapper for LocalPositionEstimateData.
table LocalPositionEstimate {
  /// Fixed-layout local-position payload.
  data:LocalPositionEstimateData;
}

/// FlatBuffers root wrapper for GlobalPositionEstimateData.
table GlobalPositionEstimate {
  /// Fixed-layout global-position payload.
  data:GlobalPositionEstimateData;
}

/// FlatBuffers root wrapper for OdometryEstimateData.
table OdometryEstimate {
  /// Fixed-layout odometry payload.
  data:OdometryEstimateData;
}

/// FlatBuffers root wrapper for PoseData.
table Pose {
  /// Fixed-layout pose payload.
  data:PoseData;
}

/// FlatBuffers root wrapper for RawPoseData.
table RawPose {
  /// Fixed-layout unfiltered pose payload.
  data:RawPoseData;
}

/// FlatBuffers root wrapper for PoseWithCovarianceData.
table PoseWithCovariance {
  /// Fixed-layout pose-with-covariance payload.
  data:PoseWithCovarianceData;
}

/// FlatBuffers root wrapper for TwistData.
table Twist {
  /// Fixed-layout twist payload.
  data:TwistData;
}

/// FlatBuffers root wrapper for TwistWithCovarianceData.
table TwistWithCovariance {
  /// Fixed-layout twist-with-covariance payload.
  data:TwistWithCovarianceData;
}

/// FlatBuffers root wrapper for OdometryData.
table Odometry {
  /// Fixed-layout compact odometry payload.
  data:OdometryData;
}

/// FlatBuffers root wrapper for OdometryWithCovarianceData.
table OdometryWithCovariance {
  /// Fixed-layout odometry-with-covariance payload.
  data:OdometryWithCovarianceData;
}

/// FlatBuffers root wrapper for ExternalOdometryData.
table ExternalOdometry {
  /// Fixed-layout external-odometry payload.
  data:ExternalOdometryData;
}

/// FlatBuffers root wrapper for ExternalOdometryCovarianceData.
table ExternalOdometryCovariance {
  /// Fixed-layout optional external-odometry covariance payload.
  data:ExternalOdometryCovarianceData;
}

/// FlatBuffers root wrapper for EstimatorHealthData.
table EstimatorHealth {
  /// Fixed-layout estimator-health payload.
  data:EstimatorHealthData;
}

/// FlatBuffers root wrapper for MissionProgressData.
table MissionProgress {
  /// Fixed-layout mission-progress payload.
  data:MissionProgressData;
}

/// FlatBuffers root wrapper for NavigationTargetData.
table NavigationTarget {
  /// Fixed-layout navigation-target payload.
  data:NavigationTargetData;
}

/// FlatBuffers root wrapper for HomeReferenceData.
table HomeReference {
  /// Fixed-layout home-reference payload.
  data:HomeReferenceData;
}
