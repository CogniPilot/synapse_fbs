include "types.fbs";

namespace synapse.topic;

// Sensor and subsystem bits for the VehicleHealthData sensor bitmasks.
enum SensorComponentFlags:uint (bit_flags) {
  Gyro, // Angular-rate sensing.
  Accel, // Linear-acceleration sensing.
  Mag, // Magnetic field sensing.
  AbsolutePressure, // Static pressure sensing.
  DifferentialPressure, // Differential pressure sensing.
  Gnss, // Global navigation satellite receiver.
  OpticalFlow, // Optical-flow sensing.
  VisionPosition, // Vision or motion-capture positioning input.
  Rangefinder, // Distance-to-surface sensing.
  RadioControl, // Manual receiver input.
  MotorOutputs, // Actuator and motor output path.
  Battery, // Battery monitoring.
  Estimator, // State estimator.
  Logging, // Onboard logging.
  CommandLink, // Command and telemetry link.
  Terrain, // Terrain database or terrain following.
}

// Vehicle-level status bits for VehicleHealthData.flags.
enum VehicleHealthFlags:ubyte (bit_flags) {
  Armed, // Actuators are allowed to produce motion.
  Failsafe, // An active failsafe is affecting vehicle behavior.
}

// Field-validity bits for AttitudeEstimateData.flags.
enum AttitudeEstimateFlags:ubyte (bit_flags) {
  AttitudeValid, // The attitude quaternion is usable.
  RatesValid, // The angular-velocity fields are usable.
}

// Field-validity bits for LocalPositionEstimateData.flags.
enum LocalPositionFlags:ubyte (bit_flags) {
  XyValid, // Horizontal position is valid.
  ZValid, // Vertical position is valid.
  VxyValid, // Horizontal velocity is valid.
  VzValid, // Vertical velocity is valid.
}

// Field-validity bits for ExternalOdometryData.flags.
enum ExternalOdometryFlags:ubyte (bit_flags) {
  PositionValid, // position_enu_m is meaningful.
  AttitudeValid, // attitude is meaningful.
  LinearVelocityValid, // linear_velocity_enu_m_s is meaningful.
  AngularVelocityValid, // angular_velocity_flu_rad_s is meaningful.
  Extrapolated, // State was predicted without a current accepted mocap correction.
  OutlierRejected, // A current mocap update was rejected by innovation gates.
  Degraded, // State is usable but tracking quality or uncertainty is degraded.
  Lost, // State should not be used for navigation.
}

// Quality/status state for external odometry producer output.
enum ExternalOdometryStatus:ubyte {
  Unknown = 0, // Producer did not report a quality/status state.
  Filtered = 1, // Current mocap update was accepted into the estimate.
  ExtrapolatedShort = 2, // Short prediction-only gap after the last accepted mocap update.
  ExtrapolatedLong = 3, // Extended prediction-only gap; downstream users should degrade behavior.
  Lost = 4, // Extrapolation exceeded the producer's safe limit.
  OutlierRejected = 5, // Current mocap update was rejected and the state was predicted.
  Degraded = 6, // Current mocap update was accepted but quality is reduced.
}

// Field-validity and estimator-state bits for OdometryData and
// OdometryWithCovarianceData.
enum OdometryFlags:ubyte (bit_flags) {
  PositionValid, // pose.position_enu_m is meaningful.
  AttitudeValid, // pose.attitude is meaningful.
  LinearVelocityValid, // twist.linear_velocity_enu_m_s is meaningful.
  AngularVelocityValid, // twist.angular_velocity_flu_rad_s is meaningful.
  Extrapolated, // State was predicted without a current accepted correction.
  OutlierRejected, // A current measurement was rejected by innovation gates.
  Degraded, // State is usable but tracking quality or uncertainty is degraded.
  Lost, // State should not be used for navigation.
}

// Quality/status state for a producer-side odometry estimate.
enum OdometryStatus:ubyte {
  Unknown = 0, // Producer did not report a quality/status state.
  Filtered = 1, // Current measurement was accepted into the estimate.
  ExtrapolatedShort = 2, // Short prediction-only gap after the last accepted measurement.
  ExtrapolatedLong = 3, // Extended prediction-only gap; downstream users should degrade behavior.
  Lost = 4, // Extrapolation exceeded the producer's safe limit.
  OutlierRejected = 5, // Current measurement was rejected and the state was predicted.
  Degraded = 6, // Current measurement was accepted but quality is reduced.
}

// Field-validity bits for GlobalPositionEstimateData.flags.
enum GlobalPositionFlags:ubyte (bit_flags) {
  Valid, // The global position estimate is usable for navigation.
  YawValid, // The yaw estimate is usable.
}

// Field-validity bits for HomeReferenceData.flags.
enum HomeReferenceFlags:ubyte (bit_flags) {
  PositionValid, // Geodetic and local home positions are valid.
  AttitudeValid, // The home alignment quaternion is valid.
  ApproachValid, // The approach vector is valid.
}

// Vehicle-wide state summary for operator displays and failsafe supervision.
struct VehicleHealthData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  sensors_present:uint; // Bitmask of SensorComponentFlags bits for detected components.
  sensors_enabled:uint; // Bitmask of SensorComponentFlags bits enabled for use.
  sensors_health:uint; // Bitmask of SensorComponentFlags bits currently considered healthy.
  sensors_present_ext:uint; // Reserved extension bitmask for future component bits.
  sensors_enabled_ext:uint; // Reserved extension bitmask for future component bits.
  sensors_health_ext:uint; // Reserved extension bitmask for future component bits.
  load_dpermille:ushort; // Main controller load as deci-percent, where 1000 means 100%.
  voltage_battery_cv:ushort; // Primary battery pack voltage in centi-volts.
  current_battery_da:short; // Primary battery current in deci-amps; positive means discharge.
  drop_rate_comm_cpercent:ushort; // Communication drop rate as centi-percent.
  errors_comm:ushort; // Communication error count.
  battery_remaining_pct:byte; // Remaining primary battery percentage, or negative when unknown.
  vehicle_type:ubyte; // Producer-defined vehicle class.
  flight_mode:ubyte; // Producer-defined active flight mode.
  system_state:ubyte; // Producer-defined high-level system state.
  link_quality_pct:ubyte; // Command/control link quality from 0 to 100.
  flags:ubyte; // Bitmask of VehicleHealthFlags bits.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Per-node clock descriptor: relates the node's timestamp_ns domain to absolute
// time and reports the discipline state. When time_status is GptpSynced the
// message timestamps are already in the shared TAI domain and time_tai_ns
// equals timestamp_ns; the mapping then matters mainly for the UTC offset and
// clock health, and it is what a free-running node uses to publish its offset.
struct TimeReferenceData {
  timestamp_ns:ulong; // Node timebase value (same domain as message timestamp_ns fields) at which the fields below were sampled.
  time_tai_ns:ulong; // IEEE 1588 TAI epoch corresponding to timestamp_ns; 0 when unsynced.
  time_unix_ns:ulong; // Unix/UTC epoch corresponding to timestamp_ns; 0 when unknown.
  uncertainty_ns:uint; // One-sigma bound on this node's time relative to the grandmaster: near-zero when GptpSynced, growing as holdover_elapsed times the oscillator drift spec. Lets a consumer degrade gracefully instead of gating binary. Requires the holdover estimator; leave 0 if not computed.
  utc_offset_s:short; // TAI minus UTC in seconds (leap-second count); 0 when unknown.
  time_status:synapse.types.TimeStatus; // Clock discipline state of this node.
  clock_class:ubyte; // IEEE 802.1AS clockClass of the served time: 6 GNSS-locked, 7 holdover, 248 free-running.
  domain:ubyte; // gPTP domain number.
  id:ubyte; // Node instance identifier; also the instance segment of the Zenoh key.
}

// Attitude estimate and angular velocity from the active estimator. The
// quaternion is the only attitude representation on the wire; consumers
// derive Euler angles locally when needed for display.
struct AttitudeEstimateData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  attitude:synapse.types.Quaternionf; // Orientation rotating body FLU vectors into the ENU world frame.
  angular_velocity_flu_rad_s:synapse.types.RateTriplet; // Body angular velocity in the FLU frame.
  flags:ubyte; // Bitmask of AttitudeEstimateFlags bits.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Local-frame position estimate for navigation and control.
struct LocalPositionEstimateData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  position_enu_m:synapse.types.Vec3f; // Local position relative to the active local origin.
  velocity_enu_m_s:synapse.types.Vec3f; // Local velocity in the ENU frame.
  acceleration_enu_m_s2:synapse.types.Vec3f; // Local acceleration in the ENU frame.
  yaw_rad:float; // Heading angle; zero east and positive counter-clockwise.
  yaw_rate_rad_s:float; // Heading rate, positive counter-clockwise.
  flags:ubyte; // Bitmask of LocalPositionFlags bits.
  xy_reset_counter:ubyte; // Increments when the estimator resets or jumps the horizontal state.
  z_reset_counter:ubyte; // Increments when the estimator resets or jumps the vertical state.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Global geodetic position estimate with compact velocity and status fields.
struct GlobalPositionEstimateData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  latitude_deg_e7:int; // Latitude in WGS-84 degrees scaled by 1e7.
  longitude_deg_e7:int; // Longitude in WGS-84 degrees scaled by 1e7.
  altitude_msl_mm:int; // Height above mean sea level.
  relative_altitude_mm:int; // Height above the active home or local origin.
  velocity_east_cm_s:short; // East component of global-frame velocity.
  velocity_north_cm_s:short; // North component of global-frame velocity.
  velocity_up_cm_s:short; // Up component of global-frame velocity.
  yaw_cdeg:short; // Heading in the range -18000 to 18000; zero east and positive counter-clockwise per REP-0103.
  source:ubyte; // Producer-defined source identifier for this global estimate.
  flags:ubyte; // Bitmask of GlobalPositionFlags bits.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Combined pose, twist, covariance, and estimator metadata.
struct OdometryEstimateData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  position_enu_m:synapse.types.Vec3f; // Local position in the ENU frame.
  attitude:synapse.types.Quaternionf; // Orientation rotating body FLU vectors into the ENU world frame.
  velocity_enu_m_s:synapse.types.Vec3f; // Linear velocity in the ENU frame.
  angular_velocity_flu_rad_s:synapse.types.RateTriplet; // Body angular velocity in the FLU frame.
  pose_covariance:synapse.types.CovarianceUpperTriangle21f; // Upper-triangular covariance for position and orientation.
  velocity_covariance:synapse.types.CovarianceUpperTriangle21f; // Upper-triangular covariance for linear and angular velocity.
  reset_counter:ubyte; // Increments when the estimator resets or jumps the state.
  estimator_type:ubyte; // Producer-defined estimator implementation identifier.
  quality_pct:byte; // Overall odometry quality percentage, or negative when unknown.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Unfiltered six-degree-of-freedom source pose measurement. Raw pose has no
// covariance unless the source reports one through a future dedicated type.
struct RawPoseData {
  timestamp_ns:ulong; // Source measurement timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  pose:synapse.types.Posef; // Measured position and body-FLU-to-ENU quaternion attitude.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Filtered six-degree-of-freedom pose sample without covariance.
struct PoseData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  pose:synapse.types.Posef; // Position and body-FLU-to-ENU quaternion attitude.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Pose sample with 6x6 tangent covariance ordered
// [x, y, z, rotation_x, rotation_y, rotation_z].
struct PoseWithCovarianceData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  pose:synapse.types.Posef; // Position and body-FLU-to-ENU quaternion attitude.
  covariance:synapse.types.CovarianceUpperTriangle21f; // Upper-triangular pose covariance.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Linear and angular velocity sample without covariance.
struct TwistData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  twist:synapse.types.Twistf; // ENU linear velocity and body-FLU angular velocity.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Twist sample with 6x6 covariance ordered
// [velocity_x, velocity_y, velocity_z, angular_x, angular_y, angular_z].
struct TwistWithCovarianceData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  twist:synapse.types.Twistf; // ENU linear velocity and body-FLU angular velocity.
  covariance:synapse.types.CovarianceUpperTriangle21f; // Upper-triangular twist covariance.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Compact combined pose, twist, and estimator metadata without covariance.
struct OdometryData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  pose:synapse.types.Posef; // Estimated position and attitude.
  twist:synapse.types.Twistf; // Estimated linear and angular velocity.
  flags:OdometryFlags; // Bitmask of OdometryFlags bits.
  status:OdometryStatus; // Producer state quality and extrapolation status.
  reset_counter:ubyte; // Increments when the estimator resets or jumps the state.
  estimator_type:ubyte; // Producer-defined estimator implementation identifier.
  quality_pct:byte; // Overall odometry quality percentage, or negative when unknown.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Odometry with the complete 12x12 tangent covariance, retaining pose-twist
// cross-correlations. State order is [x, y, z, rotation_x, rotation_y,
// rotation_z, velocity_x, velocity_y, velocity_z, angular_x, angular_y,
// angular_z].
struct OdometryWithCovarianceData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds matching the contained state. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  pose:synapse.types.Posef; // Estimated position and attitude.
  twist:synapse.types.Twistf; // Estimated linear and angular velocity.
  covariance:synapse.types.CovarianceUpperTriangle78f; // Upper-triangular 12x12 state covariance.
  flags:OdometryFlags; // Bitmask of OdometryFlags bits.
  status:OdometryStatus; // Producer state quality and extrapolation status.
  reset_counter:ubyte; // Increments when the estimator resets or jumps the state.
  estimator_type:ubyte; // Producer-defined estimator implementation identifier.
  quality_pct:byte; // Overall odometry quality percentage, or negative when unknown.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// External pose and twist measurement for estimator input. Pose is expressed
// in local/world ENU. Linear velocity is ENU. Angular velocity is body FLU.
// This is the compact high-rate path; uncertainty and estimator diagnostics
// are opt-in companion topics.
struct ExternalOdometryData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  position_enu_m:synapse.types.Vec3f; // Measured local/world position in ENU.
  attitude:synapse.types.Quaternionf; // Measured orientation rotating body FLU vectors into ENU.
  linear_velocity_enu_m_s:synapse.types.Vec3f; // Measured linear velocity in ENU.
  angular_velocity_flu_rad_s:synapse.types.RateTriplet; // Measured angular velocity in body FLU.
  flags:ExternalOdometryFlags; // Bitmask of ExternalOdometryFlags bits.
  status:ExternalOdometryStatus; // Producer state quality and extrapolation status.
  source_id:ubyte; // External source instance identifier.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
  id:ubyte; // Tracked rigid-body instance identifier; also the instance segment of the Zenoh key.
}

// Optional covariance companion for ExternalOdometryData. Publish this only when
// consumers subscribe to the covariance topic or request estimator diagnostics;
// the high-rate external odometry topic carries only pose/twist. The covariance
// is over the 12D tangent state [theta, velocity, position, angular_velocity],
// where theta is the attitude perturbation in the body-FLU tangent and
// velocity/position are ENU.
struct ExternalOdometryCovarianceData {
  timestamp_ns:ulong; // Estimate timestamp in nanoseconds matching ExternalOdometryData.timestamp_ns. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  covariance:synapse.types.CovarianceUpperTriangle78f; // Upper-triangular covariance for the 12D tangent state.
  source_id:ubyte; // External source instance identifier.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
  id:ubyte; // Tracked rigid-body instance identifier.
}

// Estimator health and innovation-test summary. The flags field is
// deliberately producer-defined: estimator status models differ between
// implementations and are standardized via discovery records, not the schema.
struct EstimatorHealthData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  flags:ushort; // Producer-defined estimator status and fault bitmask.
  velocity_test_ratio:float; // Innovation test ratio for velocity observations.
  pos_horiz_test_ratio:float; // Innovation test ratio for horizontal position observations.
  pos_vert_test_ratio:float; // Innovation test ratio for vertical position observations.
  mag_test_ratio:float; // Innovation test ratio for magnetic observations.
  hagl_test_ratio:float; // Innovation test ratio for height-above-ground observations.
  tas_test_ratio:float; // Innovation test ratio for true-airspeed observations.
  pos_horiz_accuracy_m:float; // Estimated one-sigma horizontal position accuracy.
  pos_vert_accuracy_m:float; // Estimated one-sigma vertical position accuracy.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Mission progress and mission database identifiers.
struct MissionProgressData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  mission_id:uint; // Identifier that changes when the mission plan changes.
  fence_id:uint; // Identifier that changes when the geofence set changes.
  rally_points_id:uint; // Identifier that changes when the rally-point set changes.
  current_seq:ushort; // Current mission item sequence number.
  total:ushort; // Total number of mission items known to the producer.
  mission_state:synapse.types.MissionState; // Mission execution state.
  mission_mode:ubyte; // Producer-defined mission mode or mission type.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Navigation controller target and tracking-error summary. Angles follow
// REP-0103: zero east, positive counter-clockwise, range -18000 to 18000.
struct NavigationTargetData {
  timestamp_ns:ulong; // Sample timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  altitude_error_m:float; // Target altitude minus estimated altitude.
  airspeed_error_m_s:float; // Target airspeed minus estimated airspeed.
  xtrack_error_m:float; // Cross-track error relative to the active path.
  desired_roll_cdeg:short; // Roll angle requested by navigation.
  desired_pitch_cdeg:short; // Pitch angle requested by navigation.
  desired_yaw_cdeg:short; // Navigation yaw command.
  target_yaw_cdeg:short; // Yaw toward the active target.
  distance_to_waypoint_m:ushort; // Remaining straight-line distance to the active waypoint.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Home position and local-origin reference.
struct HomeReferenceData {
  timestamp_ns:ulong; // Reference timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  latitude_deg_e7:int; // Home latitude in WGS-84 degrees scaled by 1e7.
  longitude_deg_e7:int; // Home longitude in WGS-84 degrees scaled by 1e7.
  altitude_msl_mm:int; // Home height above mean sea level.
  local_position_enu_m:synapse.types.Vec3f; // Home position in the active local ENU frame.
  attitude:synapse.types.Quaternionf; // Map-to-local alignment rotating FLU vectors at home into ENU.
  approach_enu_m:synapse.types.Vec3f; // Preferred approach point or vector in the local ENU frame.
  flags:ubyte; // Bitmask of HomeReferenceFlags bits.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// FlatBuffers root wrapper for VehicleHealthData.
table VehicleHealth {
  data:VehicleHealthData; // Fixed-layout vehicle-health payload.
}

// FlatBuffers root wrapper for TimeReferenceData.
table TimeReference {
  data:TimeReferenceData; // Fixed-layout time-reference payload.
}

// FlatBuffers root wrapper for AttitudeEstimateData.
table AttitudeEstimate {
  data:AttitudeEstimateData; // Fixed-layout attitude-estimate payload.
}

// FlatBuffers root wrapper for LocalPositionEstimateData.
table LocalPositionEstimate {
  data:LocalPositionEstimateData; // Fixed-layout local-position payload.
}

// FlatBuffers root wrapper for GlobalPositionEstimateData.
table GlobalPositionEstimate {
  data:GlobalPositionEstimateData; // Fixed-layout global-position payload.
}

// FlatBuffers root wrapper for OdometryEstimateData.
table OdometryEstimate {
  data:OdometryEstimateData; // Fixed-layout odometry payload.
}

// FlatBuffers root wrapper for PoseData.
table Pose {
  data:PoseData; // Fixed-layout pose payload.
}

// FlatBuffers root wrapper for RawPoseData.
table RawPose {
  data:RawPoseData; // Fixed-layout unfiltered pose payload.
}

// FlatBuffers root wrapper for PoseWithCovarianceData.
table PoseWithCovariance {
  data:PoseWithCovarianceData; // Fixed-layout pose-with-covariance payload.
}

// FlatBuffers root wrapper for TwistData.
table Twist {
  data:TwistData; // Fixed-layout twist payload.
}

// FlatBuffers root wrapper for TwistWithCovarianceData.
table TwistWithCovariance {
  data:TwistWithCovarianceData; // Fixed-layout twist-with-covariance payload.
}

// FlatBuffers root wrapper for OdometryData.
table Odometry {
  data:OdometryData; // Fixed-layout compact odometry payload.
}

// FlatBuffers root wrapper for OdometryWithCovarianceData.
table OdometryWithCovariance {
  data:OdometryWithCovarianceData; // Fixed-layout odometry-with-covariance payload.
}

// FlatBuffers root wrapper for ExternalOdometryData.
table ExternalOdometry {
  data:ExternalOdometryData; // Fixed-layout external-odometry payload.
}

// FlatBuffers root wrapper for ExternalOdometryCovarianceData.
table ExternalOdometryCovariance {
  data:ExternalOdometryCovarianceData; // Fixed-layout optional external-odometry covariance payload.
}

// FlatBuffers root wrapper for EstimatorHealthData.
table EstimatorHealth {
  data:EstimatorHealthData; // Fixed-layout estimator-health payload.
}

// FlatBuffers root wrapper for MissionProgressData.
table MissionProgress {
  data:MissionProgressData; // Fixed-layout mission-progress payload.
}

// FlatBuffers root wrapper for NavigationTargetData.
table NavigationTarget {
  data:NavigationTargetData; // Fixed-layout navigation-target payload.
}

// FlatBuffers root wrapper for HomeReferenceData.
table HomeReference {
  data:HomeReferenceData; // Fixed-layout home-reference payload.
}
