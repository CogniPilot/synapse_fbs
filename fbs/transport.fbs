include "types.fbs";
include "sensors.fbs";
include "inertial_batch.fbs";
include "rtcm3.fbs";
include "state.fbs";
include "control.fbs";
include "optical_flow.fbs";
include "argus.fbs";
include "mocap.fbs";
include "telemetry.fbs";
include "sim.fbs";
include "trajectory.fbs";
include "firmware.fbs";

namespace synapse.topic;

// Human-readable status text for diagnostics, operator messages, and logs.
table TextStatus {
  timestamp_ns:ulong; // Message timestamp in nanoseconds. Shared gPTP domain when time_status is not LocalFreerun, otherwise monotonic boot.
  severity:synapse.types.Severity = Informational; // RFC 5424 severity level.
  text:string; // UTF-8 status text; this table is variable-size by design.
  time_status:synapse.types.TimeStatus; // Discipline state of the clock behind the timestamps.
}

// Union of topic root tables supported by the optional multiplexed Frame
// transport. Order mirrors TopicId; the union discriminator is one byte, so
// Frame supports at most 255 topics.
union SynapseMessage {
  VehicleHealth, // Vehicle-level arming, failsafe, mode, link, and health summary.
  TimeReference, // Boot-time to Unix-time reference sample.
  RadioControl, // Raw receiver channel input sample.
  ManualControlCommand, // Normalized manual pilot intent command.
  InertialSample, // IMU accelerometer, gyroscope, and temperature sample.
  AirData, // Barometric and aerodynamic measurement sample.
  PowerStatus, // Battery or power-source state sample.
  GnssFix, // GNSS fix and motion estimate.
  OpticalFlow, // Integrated optical-flow sample.
  OpticalFlowVelocity, // Velocity estimate derived from optical flow.
  AttitudeEstimate, // Attitude and angular-velocity estimate.
  LocalPositionEstimate, // Local ENU position, velocity, acceleration, and yaw estimate.
  GlobalPositionEstimate, // Global geodetic position and velocity estimate.
  OdometryEstimate, // Combined pose, twist, covariance, and estimator metadata.
  EstimatorHealth, // Estimator health and innovation-test summary.
  MissionProgress, // Mission progress and mission database identifiers.
  NavigationTarget, // Navigation target and tracking-error summary.
  HomeReference, // Home geodetic origin and local-frame reference.
  AttitudeCommand, // Attitude setpoint command.
  RateCommand, // Body-rate setpoint command.
  LocalPositionCommand, // Local position/velocity/acceleration/yaw command.
  TrajectorySegment, // Bezier or polynomial trajectory segment setpoint.
  ActuatorCommand, // Normalized actuator command.
  ActuatorFeedback, // Normalized actuator feedback.
  PwmSignalOutputs, // Raw PWM output pulse widths.
  ControlLoopMetrics, // Control-loop timing and load metrics.
  TextStatus, // Human-readable status text.
  GcsStatus, // Compact status aggregate for low-rate ground-control links.
  ExternalOdometry, // External pose and twist measurement for estimator input.
  ExternalOdometryCovariance, // Optional external odometry covariance companion.
  MocapFrame, // Raw motion-capture marker and rigid-body samples.
  LockstepTick, // Deterministic simulation barrier tick.
  LockstepStatus, // Deterministic simulation participant status.
  FirmwareProgress, // Firmware image transfer, verification, and activation progress.
  RawPose, // Unfiltered position and quaternion attitude measurement.
  Pose, // Filtered position and quaternion attitude sample.
  PoseWithCovariance, // Filtered pose sample with covariance.
  Twist, // Linear and angular velocity sample.
  TwistWithCovariance, // Twist sample with covariance.
  Odometry, // Compact pose, twist, and estimator status.
  OdometryWithCovariance, // Odometry with complete state covariance.
  MocapPoseFrame, // Raw motion-capture frame with quaternion rigid-body attitudes.
  MagneticField, // Magnetometer sample in the body FLU frame.
  ArgusPointCloud, // Per-pixel time-of-flight range and intensity point cloud.
  Rtcm3, // Raw RTCM3 correction frame.
  InertialBatch, // Phase-locked batch of raw inertial samples.
}

// Fixed-layout header carried by the optional multiplexed Frame transport.
struct FrameHeader {
  timestamp_ns:ulong; // Frame publication timestamp in nanoseconds, monotonic boot time.
  sequence:uint; // Monotonic sequence counter for loss/reorder detection.
  flags:ushort; // Frame-envelope bitmask for serial or raw byte-stream features; zero means no envelope extensions.
  topic_id:TopicId; // Numeric topic identifier for the enclosed message.
  system_id:ubyte; // Source system identifier for links without key-based routing.
  component_id:ubyte; // Source component identifier.
  protocol_version:ubyte; // Synapse wire/schema compatibility version used by the publisher.
}

// Optional multiplexed transport frame for generic bridges and multiplexed
// byte streams. This is an intentional table boundary: the canonical Zenoh
// encoding publishes bare fixed-layout payload structs with the key as the
// discriminator, and constrained serial links should prefer the compact
// framing described in the README ([sync][len][topic_id][seq][flags]
// [bare struct][crc16]) over this envelope. Frame remains for consumers that
// need a self-contained FlatBuffers container.
table Frame {
  header:FrameHeader; // Fixed-layout transport header.
  message:SynapseMessage; // Variable message payload selected by the union discriminator.
}

root_type Frame;
file_identifier "SYFR";
