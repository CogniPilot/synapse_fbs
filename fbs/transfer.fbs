include "types.fbs";
include "trajectory.fbs";

namespace synapse.cmd;

/// Stable numeric identifiers for command and transfer services. Zenoh
/// deployments select services by key name under synapse/v1/cmd; non-Zenoh
/// request/reply transports such as framed serial links use these ids as the
/// service discriminator. Values mirror the generated command catalog.
enum CmdId:ushort {
  /// Reserved value for invalid or unassigned services.
  Unknown = 0,
  /// Fetch one parameter by name, or a paged parameter catalog chunk.
  ParamGet = 1,
  /// Set one parameter.
  ParamSet = 2,
  /// Fetch a paged GPS mission chunk.
  MissionGet = 3,
  /// Replace or patch a GPS mission in bounded chunks.
  MissionSet = 4,
  /// Fetch a paged trajectory segment chunk.
  TrajectoryGet = 5,
  /// Replace or patch a trajectory in bounded chunks.
  TrajectorySet = 6,
  /// Fetch firmware/update capabilities.
  FirmwareInfo = 7,
  /// Fetch firmware update state/progress.
  FirmwareStatus = 8,
  /// Prepare a maintenance-mode firmware update.
  FirmwarePrepare = 9,
  /// Transfer one staged firmware image chunk.
  FirmwareChunk = 10,
  /// Commit a staged image for bootloader test boot.
  FirmwareCommit = 11,
  /// Abort a staged firmware update.
  FirmwareAbort = 12,
}

/// Value type carried by a ParamValue record.
enum ParamKind:ubyte {
  /// float_value carries the parameter.
  Float = 0,
  /// int_value carries the parameter.
  Int = 1,
  /// int_value carries the parameter as zero or one.
  Bool = 2,
  /// text_value carries the parameter.
  Text = 3,
}

/// Common flags for paged transfer requests and replies.
enum TransferFlags:ushort (bit_flags) {
  /// This chunk starts a transfer.
  First,
  /// This chunk completes a transfer.
  Last,
  /// More chunks are expected after this reply.
  More,
  /// Receiver should commit the staged transfer after accepting this chunk.
  Commit,
  /// failed_seq identifies the item or segment that failed validation.
  FailedSeqValid,
}

/// GPS mission item class.
enum MissionItemKind:ubyte {
  /// Navigate to a geographic waypoint.
  Waypoint = 0,
  /// Take off to the target altitude.
  Takeoff = 1,
  /// Land at the target location.
  Land = 2,
  /// Hold at the target location.
  Loiter = 3,
}

/// Mission item validity and behavior bits.
enum MissionItemFlags:ushort (bit_flags) {
  /// Receiver should make this the current item when committed.
  Current,
  /// Navigation should automatically continue after completing this item.
  Autocontinue,
  /// yaw_rad is meaningful.
  YawValid,
  /// acceptance_radius_m is meaningful.
  AcceptanceRadiusValid,
  /// loiter_time_s is meaningful.
  LoiterTimeValid,
}

/// One named parameter value. Tables are appropriate here: parameter transfer
/// is a cached request/reply flow, never a control-loop payload.
table ParamValue {
  /// Parameter name unique within the producer.
  name:string;
  /// Which value field carries the parameter.
  kind:ParamKind;
  /// Floating-point value when kind is Float.
  float_value:double;
  /// Integer or boolean value when kind is Int or Bool.
  int_value:long;
  /// Text value when kind is Text.
  text_value:string;
}

/// Request one parameter by name, or a paged catalog chunk when name is absent.
/// Served as a Zenoh queryable on the cmd key space.
table ParamGetRequest {
  /// Parameter name to fetch; absent or empty requests the catalog page.
  name:string;
  /// First parameter index requested for paged catalog reads.
  offset:uint;
  /// Maximum number of parameter values requested.
  limit:ushort;
}

/// Reply to ParamGetRequest.
table ParamGetReply {
  /// Request outcome.
  result:synapse.types.CommandResultCode;
  /// Returned parameter values.
  values:[ParamValue];
  /// First parameter index carried in values.
  offset:uint;
  /// Total number of parameters held by the producer.
  total:uint;
  /// Producer-defined extended result or error detail.
  result_detail:int;
  /// Bitmask of TransferFlags bits.
  flags:ushort;
}

/// Request to set one parameter. Served as a Zenoh queryable.
table ParamSetRequest {
  /// Parameter name and new value.
  value:ParamValue;
}

/// Reply to ParamSetRequest.
table ParamSetReply {
  /// Request outcome.
  result:synapse.types.CommandResultCode;
  /// Parameter value in effect after the request.
  value:ParamValue;
  /// Producer-defined extended result or error detail.
  result_detail:int;
}

/// One fixed-layout GPS mission item. This is not a generic command; it is the
/// compact transfer representation for GPS waypoint-style missions.
struct MissionItemData {
  /// Item sequence number starting at zero.
  seq:uint;
  /// Target latitude in WGS-84 degrees scaled by 1e7.
  latitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-90", max: "90");
  /// Target longitude in WGS-84 degrees scaled by 1e7.
  longitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-180", max: "180");
  /// Target altitude in meters in the selected frame.
  altitude_m:float (unit: "m");
  /// Acceptance radius in meters when the corresponding flag is set.
  acceptance_radius_m:float (unit: "m", min: "0", valid_if: "flags.AcceptanceRadiusValid");
  /// Loiter duration in seconds when the corresponding flag is set.
  loiter_time_s:float (unit: "s", min: "0", valid_if: "flags.LoiterTimeValid");
  /// Requested yaw angle when the corresponding flag is set.
  yaw_rad:float (unit: "rad", valid_if: "flags.YawValid");
  /// Altitude reference frame for altitude_m.
  frame:synapse.types.GeoAltitudeFrame;
  /// GPS mission item class.
  kind:MissionItemKind;
  /// Bitmask of MissionItemFlags bits.
  flags:ushort;
}

/// Request a bounded GPS mission chunk. Served as a Zenoh queryable.
table MissionGetRequest {
  /// Mission identifier to fetch, or zero for the current plan.
  mission_id:uint;
  /// First mission item sequence requested.
  offset:uint;
  /// Maximum number of items requested.
  limit:ushort;
}

/// Reply to MissionGetRequest.
table MissionGetReply {
  /// Request outcome.
  result:synapse.types.CommandResultCode;
  /// Identifier of the returned plan; matches MissionProgressData.mission_id.
  mission_id:uint;
  /// Monotonic mission revision identifier.
  plan_version:uint;
  /// First mission item sequence carried in items.
  offset:uint;
  /// Total number of mission items in the plan.
  total:uint;
  /// Producer-defined extended result or error detail.
  result_detail:int;
  /// Failed item sequence when FailedSeqValid is set.
  failed_seq:uint;
  /// Bitmask of TransferFlags bits.
  flags:ushort;
  /// Mission items in sequence order.
  items:[MissionItemData];
}

/// Request to replace or patch a GPS mission in bounded chunks. Served as a
/// Zenoh queryable and by non-Zenoh request/reply transports.
table MissionSetRequest {
  /// Identifier the producer should report for this plan.
  mission_id:uint;
  /// Required current revision, or zero when the producer permits blind replace.
  expected_plan_version:uint;
  /// New mission revision identifier.
  plan_version:uint;
  /// First mission item sequence carried in items.
  offset:uint;
  /// Total number of mission items in the final plan.
  total:uint;
  /// CRC-32 of the complete final plan in canonical transfer encoding.
  plan_crc32:uint;
  /// Bitmask of TransferFlags bits.
  flags:ushort;
  /// Mission items in sequence order for this chunk.
  items:[MissionItemData];
}

/// Reply to MissionSetRequest.
table MissionSetReply {
  /// Request outcome.
  result:synapse.types.CommandResultCode;
  /// Identifier of the plan now staged or active in the producer.
  mission_id:uint;
  /// Mission revision accepted by the producer.
  plan_version:uint;
  /// Producer-defined extended result or error detail.
  result_detail:int;
  /// Failed item sequence when FailedSeqValid is set.
  failed_seq:uint;
  /// Bitmask of TransferFlags bits.
  flags:ushort;
}

/// Request a bounded trajectory segment chunk. Served as a Zenoh queryable.
table TrajectoryGetRequest {
  /// Trajectory identifier to fetch.
  trajectory_id:uint;
  /// First trajectory segment sequence requested.
  offset:uint;
  /// Maximum number of segments requested.
  limit:ushort;
}

/// Reply to TrajectoryGetRequest.
table TrajectoryGetReply {
  /// Request outcome.
  result:synapse.types.CommandResultCode;
  /// Identifier of the returned trajectory.
  trajectory_id:uint;
  /// Monotonic trajectory revision identifier.
  plan_version:uint;
  /// First segment sequence carried in segments.
  offset:uint;
  /// Total number of segments in the trajectory.
  total:uint;
  /// Producer-defined extended result or error detail.
  result_detail:int;
  /// Failed segment sequence when FailedSeqValid is set.
  failed_seq:uint;
  /// Bitmask of TransferFlags bits.
  flags:ushort;
  /// Fixed-layout trajectory segment payloads.
  segments:[synapse.topic.TrajectorySegmentData];
}

/// Request to replace or patch a trajectory in bounded chunks.
table TrajectorySetRequest {
  /// Trajectory identifier the producer should report for this plan.
  trajectory_id:uint;
  /// Required current revision, or zero when the producer permits blind replace.
  expected_plan_version:uint;
  /// New trajectory revision identifier.
  plan_version:uint;
  /// First segment sequence carried in segments.
  offset:uint;
  /// Total number of segments in the final trajectory.
  total:uint;
  /// CRC-32 of the complete final trajectory in canonical transfer encoding.
  plan_crc32:uint;
  /// Bitmask of TransferFlags bits.
  flags:ushort;
  /// Fixed-layout trajectory segment payloads.
  segments:[synapse.topic.TrajectorySegmentData];
}

/// Reply to TrajectorySetRequest.
table TrajectorySetReply {
  /// Request outcome.
  result:synapse.types.CommandResultCode;
  /// Identifier of the trajectory now staged or active in the producer.
  trajectory_id:uint;
  /// Trajectory revision accepted by the producer.
  plan_version:uint;
  /// Producer-defined extended result or error detail.
  result_detail:int;
  /// Failed segment sequence when FailedSeqValid is set.
  failed_seq:uint;
  /// Bitmask of TransferFlags bits.
  flags:ushort;
}
