include "types.fbs";

namespace synapse.topic;

/// Field-validity bits for InertialSampleData.flags.
enum InertialFieldFlags:ubyte (bit_flags) {
  /// Accelerometer fields were updated in this sample.
  Accel,
  /// Gyroscope fields were updated in this sample.
  Gyro,
  /// Magnetometer fields were updated in this sample.
  Mag,
  /// Static pressure field was updated in this sample.
  Pressure,
  /// Temperature field was updated in this sample.
  Temperature,
}

/// Field-validity bits for AirDataData.flags.
enum AirDataFlags:ubyte (bit_flags) {
  /// Static pressure is valid.
  AbsolutePressure,
  /// Differential pressure is valid.
  DifferentialPressure,
  /// Pressure altitude is valid.
  PressureAltitude,
  /// Indicated airspeed is valid.
  IndicatedAirspeed,
  /// True airspeed is valid.
  TrueAirspeed,
  /// Angle of attack is valid.
  AngleOfAttack,
  /// Sideslip angle is valid.
  Sideslip,
  /// Temperature fields are valid.
  Temperature,
}

/// Field-validity bits for GnssFixData.flags.
enum GnssFixFlags:ubyte (bit_flags) {
  /// time_unix_us carries a valid receiver time.
  TimeValid,
  /// course_over_ground_cdeg is valid.
  CourseValid,
  /// yaw_cdeg carries a valid receiver yaw.
  YawValid,
  /// velocity_up_cm_s is valid.
  VelocityUpValid,
}

/// Fault bits for PowerStatusData.fault_flags.
enum PowerFaultFlags:ushort (bit_flags) {
  /// Pack was discharged below its safe minimum.
  DeepDischarge,
  /// Abnormal voltage transients were detected.
  VoltageSpikes,
  /// One or more cells failed.
  CellFail,
  /// Discharge current exceeded limits.
  OverCurrent,
  /// Pack temperature exceeded limits.
  OverTemperature,
  /// Pack temperature is below operating limits.
  UnderTemperature,
  /// Pack voltage is incompatible with this vehicle.
  IncompatibleVoltage,
  /// Monitor or pack hardware failure.
  HardwareFailure,
}

/// Raw inertial and environmental sample from an IMU-class sensor. This is a
/// raw-layer topic: values are sensor-native measurements in the body FLU
/// mounting frame after driver axis alignment; no estimator products belong
/// here. Sensors updating at different rates set the matching flags bits.
struct InertialSampleData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Linear acceleration in the body FLU frame.
  accel_flu_m_s2:synapse.types.Vec3f (unit: "m/s2", frame: "flu", valid_if: "flags.Accel");
  /// Angular rate in the body FLU frame.
  gyro_flu_rad_s:synapse.types.Vec3f (unit: "rad/s", frame: "flu", valid_if: "flags.Gyro");
  /// Raw magnetic field in the body FLU frame, not declination corrected.
  mag_flu_tesla:synapse.types.Vec3f (unit: "T", frame: "flu", valid_if: "flags.Mag");
  /// Static pressure from the sensor barometer.
  absolute_pressure_hpa:float (unit: "hPa", min: "0", valid_if: "flags.Pressure");
  /// Sensor temperature in degrees Celsius.
  temperature_c:float (unit: "Cel", valid_if: "flags.Temperature");
  /// Bitmask of InertialFieldFlags bits updated in this sample.
  flags:ubyte;
  /// Sensor instance identifier; also the instance segment of the Zenoh key.
  id:ubyte;
}

/// Air-data sample used by fixed-wing estimators and controllers.
struct AirDataData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Static pressure used for altitude and air-density calculations.
  absolute_pressure_hpa:float (unit: "hPa", min: "0", valid_if: "flags.AbsolutePressure");
  /// Pitot/static differential pressure used for airspeed.
  differential_pressure_hpa:float (unit: "hPa", valid_if: "flags.DifferentialPressure");
  /// Pressure-derived altitude using the producer's atmosphere model.
  pressure_altitude_m:float (unit: "m", valid_if: "flags.PressureAltitude");
  /// Indicated airspeed before density correction.
  indicated_airspeed_m_s:float (unit: "m/s", min: "0", valid_if: "flags.IndicatedAirspeed");
  /// True airspeed after density correction when available.
  true_airspeed_m_s:float (unit: "m/s", min: "0", valid_if: "flags.TrueAirspeed");
  /// Angle between body X axis and relative wind in the pitch plane.
  angle_of_attack_rad:float (unit: "rad", valid_if: "flags.AngleOfAttack");
  /// Angle between body X axis and relative wind in the yaw plane.
  sideslip_rad:float (unit: "rad", valid_if: "flags.Sideslip");
  /// Static-air temperature in centi-degrees Celsius.
  temperature_cdeg:short (unit: "Cel", scale: "1e-2", valid_if: "flags.Temperature");
  /// Differential-pressure sensor temperature in centi-degrees Celsius.
  differential_pressure_temperature_cdeg:short (unit: "Cel", scale: "1e-2", valid_if: "flags.Temperature");
  /// Bitmask of AirDataFlags bits valid in this sample.
  flags:ubyte;
}

/// Per-cell battery voltages for packs with up to sixteen monitored cells.
/// Unmonitored cell slots are zero; zero is physically impossible for a
/// connected, monitored cell.
struct BatteryCellVoltages16 {
  /// Cell 0 voltage, or zero when unmonitored.
  cell0_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 1 voltage, or zero when unmonitored.
  cell1_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 2 voltage, or zero when unmonitored.
  cell2_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 3 voltage, or zero when unmonitored.
  cell3_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 4 voltage, or zero when unmonitored.
  cell4_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 5 voltage, or zero when unmonitored.
  cell5_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 6 voltage, or zero when unmonitored.
  cell6_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 7 voltage, or zero when unmonitored.
  cell7_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 8 voltage, or zero when unmonitored.
  cell8_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 9 voltage, or zero when unmonitored.
  cell9_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 10 voltage, or zero when unmonitored.
  cell10_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 11 voltage, or zero when unmonitored.
  cell11_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 12 voltage, or zero when unmonitored.
  cell12_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 13 voltage, or zero when unmonitored.
  cell13_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 14 voltage, or zero when unmonitored.
  cell14_mv:ushort (unit: "V", scale: "1e-3", min: "0");
  /// Cell 15 voltage, or zero when unmonitored.
  cell15_mv:ushort (unit: "V", scale: "1e-3", min: "0");
}

/// Battery or power-source state used for monitoring and failsafe decisions.
struct PowerStatusData {
  /// Sample timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Per-cell voltages for the monitored pack.
  voltages:BatteryCellVoltages16;
  /// Integrated discharged capacity since the producer's reset point.
  current_consumed_mah:int (unit: "A.h", scale: "1e-3", min: "0");
  /// Integrated discharged energy since the producer's reset point.
  energy_consumed_hj:int (unit: "J", scale: "100", min: "0");
  /// Estimated remaining runtime, or a negative value when unknown.
  time_remaining_s:int (unit: "s", min: "0", valid_if: "value >= 0");
  /// Bitmask of PowerFaultFlags bits.
  fault_flags:ushort;
  /// Battery current in deci-amps; positive means discharge.
  current_battery_da:short (unit: "A", scale: "1e-1");
  /// Battery or power-module temperature in centi-degrees Celsius.
  temperature_cdeg:short (unit: "Cel", scale: "1e-2");
  /// Remaining state of charge, or negative when unknown.
  remaining_pct:byte (unit: "%", min: "0", max: "100", valid_if: "value >= 0");
  /// Battery instance identifier; also the instance segment of the Zenoh key.
  id:ubyte;
  /// Role of this power source on the vehicle.
  battery_function:synapse.types.BatteryFunction;
  /// Battery chemistry or power-source type.
  battery_type:synapse.types.BatteryType;
  /// Charging or discharge health state.
  charge_state:synapse.types.BatteryChargeState;
  /// True when the power source is physically present and reporting.
  connected:bool;
}

/// Global navigation satellite receiver fix and motion estimate. This is a
/// raw-layer topic: angles keep the receiver's native convention (clockwise
/// from true north) so logs stay faithful to the hardware; the estimator
/// converts to REP-0103 conventions for estimate-layer topics.
struct GnssFixData {
  /// Fix timestamp in monotonic boot time.
  timestamp_us:ulong (unit: "s", clock: "monotonic_boot", scale: "1e-6", min: "0");
  /// Receiver-reported Unix time of the fix; valid when GnssFixFlags.TimeValid is set.
  time_unix_us:ulong (unit: "s", clock: "unix_epoch", scale: "1e-6", min: "0", valid_if: "flags.TimeValid");
  /// Latitude in WGS-84 degrees scaled by 1e7.
  latitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-90", max: "90");
  /// Longitude in WGS-84 degrees scaled by 1e7.
  longitude_deg_e7:int (unit: "deg", frame: "wgs84", scale: "1e-7", min: "-180", max: "180");
  /// Height above mean sea level.
  altitude_msl_mm:int (unit: "m", scale: "1e-3");
  /// Height above the WGS-84 ellipsoid.
  altitude_ellipsoid_mm:int (unit: "m", scale: "1e-3");
  /// One-sigma horizontal accuracy; producers must saturate at 65535, never truncation-cast (65535 means at or above 65.535 m, unusable).
  horizontal_accuracy_mm:ushort (unit: "m", scale: "1e-3", min: "0");
  /// One-sigma vertical accuracy; producers must saturate at 65535, never truncation-cast.
  vertical_accuracy_mm:ushort (unit: "m", scale: "1e-3", min: "0");
  /// One-sigma velocity accuracy; producers must saturate at 65535, never truncation-cast.
  velocity_accuracy_mm_s:ushort (unit: "m/s", scale: "1e-3", min: "0");
  /// One-sigma yaw accuracy when receiver yaw is available.
  yaw_accuracy_cdeg:ushort (unit: "deg", scale: "1e-2", min: "0");
  /// Horizontal dilution of precision scaled by 100.
  hdop_centi:ushort (unit: "1", scale: "1e-2", min: "0");
  /// Vertical dilution of precision scaled by 100.
  vdop_centi:ushort (unit: "1", scale: "1e-2", min: "0");
  /// Horizontal ground speed magnitude.
  ground_speed_cm_s:ushort (unit: "m/s", scale: "1e-2", min: "0");
  /// Course over ground, receiver native: zero at true north, positive clockwise; valid when CourseValid is set.
  course_over_ground_cdeg:ushort (unit: "deg", scale: "1e-2", min: "0", max: "360", valid_if: "flags.CourseValid");
  /// Receiver-reported vehicle yaw, zero at true north, positive clockwise; valid when YawValid is set.
  yaw_cdeg:ushort (unit: "deg", scale: "1e-2", min: "0", max: "360", valid_if: "flags.YawValid");
  /// Vertical velocity, positive up; valid when VelocityUpValid is set.
  velocity_up_cm_s:short (unit: "m/s", scale: "1e-2", valid_if: "flags.VelocityUpValid");
  /// Bitmask of GnssFixFlags bits.
  flags:ubyte;
  /// Receiver fix quality.
  fix_type:synapse.types.GnssFixType;
  /// Number of satellites used in the solution.
  satellites_used:ubyte;
  /// Number of satellites tracked or visible.
  satellites_visible:ubyte;
  /// GNSS receiver instance identifier; also the instance segment of the Zenoh key.
  id:ubyte;
}

/// FlatBuffers root wrapper for InertialSampleData.
table InertialSample {
  /// Fixed-layout inertial payload.
  data:InertialSampleData;
}

/// FlatBuffers root wrapper for AirDataData.
table AirData {
  /// Fixed-layout air-data payload.
  data:AirDataData;
}

/// FlatBuffers root wrapper for PowerStatusData.
table PowerStatus {
  /// Fixed-layout power-status payload.
  data:PowerStatusData;
}

/// FlatBuffers root wrapper for GnssFixData.
table GnssFix {
  /// Fixed-layout GNSS fix payload.
  data:GnssFixData;
}
