include "types.fbs";
include "control.fbs";

namespace synapse.sil;

// Simulation input root passed from a simulator into a controller under test.
table SimInput {
  gyro_flu_rad_s:synapse.types.Vec3f; // Simulated body angular velocity in the FLU frame.
  accel_flu_m_s2:synapse.types.Vec3f; // Simulated body linear acceleration in the FLU frame.
  rc:synapse.topic.RadioControlData; // Simulated raw receiver input sample.
  rc_link_quality_pct:ubyte; // Simulated receiver link quality from 0 to 100.
  rc_valid:bool; // True when rc contains a valid receiver sample.
  imu_valid:bool; // True when gyro and accel contain valid inertial data.
  target_boot_time_us:ulong; // Target controller boot time for deterministic simulation stepping.
}

root_type SimInput;
file_identifier "SYSI";
