// Synapse shared types, core protocol enums, and topic identifiers.
//
// Frame conventions are layered:
// - Raw sensor topics carry the sensor's native conventions, documented per
//   field (for example GNSS course over ground is clockwise from true north).
// - Estimate and command topics follow ROS REP-0103: world/local vectors use
//   ENU (x east, y north, z up), body vectors use FLU (x forward, y left,
//   z up), SI units unless an explicit scaled-integer suffix says otherwise.
// - Operator displays may format values however pilots expect (for example
//   compass headings); display formatting is never a wire-format concern.
//
// Fixed memory layout is a protocol priority. Runtime telemetry, state,
// command, and control payloads are structs so that shared memory, Zenoh
// values, radio frames, and log messages all carry identical bytes. Little
// endian byte order is a protocol requirement. Use tables only for
// FlatBuffers roots, unions, request/reply payloads, or naturally
// variable-size data.
//
// Field validity uses one schema-defined flags bitmask per message. Sentinel
// values are never used; zero-means-unavailable is allowed only where zero is
// physically impossible. Scaled integer fields use explicit unit suffixes.

namespace synapse.types;

// Two-component float vector used for planar rates, flow, and image motion.
struct Vec2f {
  x:float; // First axis component; frame and unit are defined by the containing field name.
  y:float; // Second axis component; frame and unit are defined by the containing field name.
}

// Three-component float vector used for ENU world vectors and FLU body vectors.
struct Vec3f {
  x:float; // X component; east in ENU fields and forward in FLU fields.
  y:float; // Y component; north in ENU fields and left in FLU fields.
  z:float; // Z component; up in both ENU and FLU fields.
}

// Unit quaternion in Hamilton convention, component order w, x, y, z.
// It rotates body-frame FLU vectors into the world ENU frame:
// v_enu = q * v_flu * conjugate(q). Identity rotation is 1, 0, 0, 0.
struct Quaternionf {
  w:float; // Scalar component.
  x:float; // Vector X component.
  y:float; // Vector Y component.
  z:float; // Vector Z component.
}

// Row-major 3x3 rotation matrix.
struct RotationMatrix3f {
  r11:float; // Row 1, column 1.
  r12:float; // Row 1, column 2.
  r13:float; // Row 1, column 3.
  r21:float; // Row 2, column 1.
  r22:float; // Row 2, column 2.
  r23:float; // Row 2, column 3.
  r31:float; // Row 3, column 1.
  r32:float; // Row 3, column 2.
  r33:float; // Row 3, column 3.
}

// Roll, pitch, and yaw rates or rate setpoints about the FLU body axes.
struct RateTriplet {
  roll:float; // Rotation rate about the body X (forward) axis.
  pitch:float; // Rotation rate about the body Y (left) axis.
  yaw:float; // Rotation rate about the body Z (up) axis.
}

// Upper-triangular 6x6 covariance matrix stored row-major as 21 float values.
// State order is x, y, z translation followed by rotation about x, y, z.
struct CovarianceUpperTriangle21f {
  c0:float; // Matrix element (0,0).
  c1:float; // Matrix element (0,1).
  c2:float; // Matrix element (0,2).
  c3:float; // Matrix element (0,3).
  c4:float; // Matrix element (0,4).
  c5:float; // Matrix element (0,5).
  c6:float; // Matrix element (1,1).
  c7:float; // Matrix element (1,2).
  c8:float; // Matrix element (1,3).
  c9:float; // Matrix element (1,4).
  c10:float; // Matrix element (1,5).
  c11:float; // Matrix element (2,2).
  c12:float; // Matrix element (2,3).
  c13:float; // Matrix element (2,4).
  c14:float; // Matrix element (2,5).
  c15:float; // Matrix element (3,3).
  c16:float; // Matrix element (3,4).
  c17:float; // Matrix element (3,5).
  c18:float; // Matrix element (4,4).
  c19:float; // Matrix element (4,5).
  c20:float; // Matrix element (5,5).
}

// Upper-triangular 12x12 covariance matrix stored row-major as 78 float
// values. For external odometry covariance the tangent-state order is
// attitude perturbation, velocity, position, angular velocity.
struct CovarianceUpperTriangle78f {
  c0:float; // Upper-triangular covariance element 0.
  c1:float; // Upper-triangular covariance element 1.
  c2:float; // Upper-triangular covariance element 2.
  c3:float; // Upper-triangular covariance element 3.
