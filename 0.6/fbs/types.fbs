  c47:float; // Upper-triangular covariance element 47.
  c48:float; // Upper-triangular covariance element 48.
  c49:float; // Upper-triangular covariance element 49.
  c50:float; // Upper-triangular covariance element 50.
  c51:float; // Upper-triangular covariance element 51.
  c52:float; // Upper-triangular covariance element 52.
  c53:float; // Upper-triangular covariance element 53.
  c54:float; // Upper-triangular covariance element 54.
  c55:float; // Upper-triangular covariance element 55.
  c56:float; // Upper-triangular covariance element 56.
  c57:float; // Upper-triangular covariance element 57.
  c58:float; // Upper-triangular covariance element 58.
  c59:float; // Upper-triangular covariance element 59.
  c60:float; // Upper-triangular covariance element 60.
  c61:float; // Upper-triangular covariance element 61.
  c62:float; // Upper-triangular covariance element 62.
