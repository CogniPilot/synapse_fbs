  c17:float; // Upper-triangular covariance element 17.
  c18:float; // Upper-triangular covariance element 18.
  c19:float; // Upper-triangular covariance element 19.
  c20:float; // Upper-triangular covariance element 20.
  c21:float; // Upper-triangular covariance element 21.
  c22:float; // Upper-triangular covariance element 22.
  c23:float; // Upper-triangular covariance element 23.
  c24:float; // Upper-triangular covariance element 24.
  c25:float; // Upper-triangular covariance element 25.
  c26:float; // Upper-triangular covariance element 26.
