/// Instance segments are 1 to 9 ASCII digits; this grammar is identical in
/// the Rust, Python, JavaScript, and C catalog helpers.
fn parse_instance(segment: &str) -> Option<u32> {
    if segment.is_empty() || segment.len() > 9 || !segment.bytes().all(|byte| byte.is_ascii_digit())
    {
        return None;
    }
    segment.parse().ok()
}

/// Parse a possibly namespaced topic key expression such as
/// `cub1/synapse/v1/topic/inertial_sample/0`. Leading and trailing slashes
/// are ignored; the namespace may be empty or contain multiple segments.
pub fn parse_key(key: &str) -> Option<ParsedTopicKey<'_>> {
    let trimmed = key.trim_matches('/');

    // Find TOPIC_KEY_PREFIX at a segment boundary.
    let mut search = 0;
    let rest = loop {
        let candidate = &trimmed[search..];
        if let Some(rest) = candidate
            .strip_prefix(TOPIC_KEY_PREFIX)
            .and_then(|rest| rest.strip_prefix('/'))
        {
            break rest;
        }
        match candidate.find('/') {
            Some(offset) => search += offset + 1,
            None => return None,
        }
    };

    let namespace = trimmed[..search].trim_end_matches('/');
    let mut segments = rest.split('/');
    let suffix = segments.next().filter(|segment| !segment.is_empty())?;
    let topic = TOPICS.iter().find(|topic| topic.key_suffix == suffix)?;
    let instance = match segments.next() {
        None => None,
        Some(segment) => Some(parse_instance(segment)?),
    };
    if segments.next().is_some() {
        return None;
    }

    Some(ParsedTopicKey {
        namespace,
        topic,
        instance,
    })
}

/// Look up a topic by canonical key, bare key suffix, or any namespaced key.
pub fn topic_by_key(key: &str) -> Option<&'static TopicInfo> {
    let key = key.trim_start_matches('/');
    TOPICS
        .iter()
        .find(|topic| topic.key == key || topic.key_suffix == key)
        .or_else(|| parse_key(key).map(|parsed| parsed.topic))
}

pub fn key_for_topic(topic: &str) -> Option<&'static str> {
    topic_by_name(topic)
        .or_else(|| topic_by_key(topic))
        .map(|topic| topic.key)
}

pub fn key_for_topic_id(id: u16) -> Option<&'static str> {
    topic_by_id(id).map(|topic| topic.key)
}

pub fn command_by_name(name: &str) -> Option<&'static CommandInfo> {
    COMMANDS.iter().find(|command| command.name == name)
}
