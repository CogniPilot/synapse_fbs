pub fn topic_by_id(id: u16) -> Option<&'static TopicInfo> {
    TOPICS.iter().find(|topic| topic.id == id)
}

pub fn topic_by_name(name: &str) -> Option<&'static TopicInfo> {
    TOPICS.iter().find(|topic| topic.name == name)
}

/// Instance segments are 1 to 9 ASCII digits; this grammar is identical in
/// the Rust, Python, JavaScript, and C catalog helpers.
fn parse_instance(segment: &str) -> Option<u32> {
    if segment.is_empty() || segment.len() > 9 || !segment.bytes().all(|byte| byte.is_ascii_digit())
    {
        return None;
    }
    segment.parse().ok()
}

/// Parse a possibly namespaced topic key expression such as `cub1/odom`,
/// `qualisys/cub1/external_pose`, or `cub1/imu/0`. The topic key is the last
/// segment, or the second-to-last when an instance segment follows; everything
/// before it is the deployment namespace, which may be empty or contain
/// multiple segments. Leading and trailing slashes are ignored.
pub fn parse_key(key: &str) -> Option<ParsedTopicKey<'_>> {
    let trimmed = key.trim_matches('/');
    if trimmed.is_empty() {
        return None;
    }

    let (rest, last) = trimmed
        .rsplit_once('/')
        .unwrap_or(("", trimmed));
    if let Some(topic) = TOPICS.iter().find(|topic| topic.key == last) {
        return Some(ParsedTopicKey {
            namespace: rest.trim_end_matches('/'),
            topic,
            instance: None,
        });
    }

    // Topic keys never consist solely of digits, so a trailing instance
    // segment is unambiguous.
    let instance = parse_instance(last)?;
    let (namespace, name) = rest.rsplit_once('/').unwrap_or(("", rest));
    let topic = TOPICS.iter().find(|topic| topic.key == name)?;
    Some(ParsedTopicKey {
        namespace: namespace.trim_end_matches('/'),
        topic,
        instance: Some(instance),
    })
}

/// Look up a topic by canonical key or any namespaced key expression.
pub fn topic_by_key(key: &str) -> Option<&'static TopicInfo> {
    let key = key.trim_start_matches('/');
    TOPICS
        .iter()
        .find(|topic| topic.key == key)
        .or_else(|| parse_key(key).map(|parsed| parsed.topic))
}

pub fn key_for_topic(topic: &str) -> Option<&'static str> {
    topic_by_name(topic)
        .or_else(|| topic_by_key(topic))
        .map(|topic| topic.key)
}

pub fn key_for_topic_id(id: u16) -> Option<&'static str> {
    topic_by_id(id).map(|topic| topic.key)
}

pub fn command_by_name(name: &str) -> Option<&'static CommandInfo> {
    COMMANDS.iter().find(|command| command.name == name)
}
