/* Generated by xtask from fbs/types.fbs and root wrapper tables. */
#include <synapse/topic_print.h>

#include <inttypes.h>
#include <stdbool.h>
#include <stdio.h>
#include <string.h>

{%- for entry in structs %}
static const synapse_field_desc_t synapse_fields_{{ entry.payload_type }}[] = {
{%- for field in entry.fields %}
    { {{ field.name|tojson }}, {{ field.offset }}, {{ field.kind }} },
{%- endfor %}
};
{% endfor %}
static const synapse_topic_fields_t synapse_topic_field_tables[] = {
{%- for entry in structs %}
    { {{ entry.topic_id }}, {{ entry.payload_size }}, {{ entry.field_count }},
      synapse_fields_{{ entry.payload_type }} },
{%- endfor %}
};

const synapse_topic_fields_t *synapse_topic_fields_by_id(uint16_t topic_id)
{
    size_t count = sizeof(synapse_topic_field_tables) /
                   sizeof(synapse_topic_field_tables[0]);
    for (size_t i = 0; i < count; ++i) {
        if (synapse_topic_field_tables[i].topic_id == topic_id) {
            return &synapse_topic_field_tables[i];
        }
    }
    return NULL;
}

int synapse_field_snprint(char *out, size_t out_size,
                          const synapse_field_desc_t *field,
                          const void *payload)
{
    const uint8_t *base = (const uint8_t *)payload + field->offset;

    switch ((synapse_field_kind_t)field->kind) {
    case SYNAPSE_FIELD_BOOL: {
        uint8_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%u", field->name,
                        (unsigned)(value != 0U));
    }
    case SYNAPSE_FIELD_I8: {
        int8_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIi8, field->name, value);
    }
    case SYNAPSE_FIELD_U8: {
        uint8_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIu8, field->name, value);
    }
    case SYNAPSE_FIELD_I16: {
        int16_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIi16, field->name, value);
    }
    case SYNAPSE_FIELD_U16: {
        uint16_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIu16, field->name, value);
    }
    case SYNAPSE_FIELD_I32: {
        int32_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIi32, field->name, value);
    }
    case SYNAPSE_FIELD_U32: {
        uint32_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIu32, field->name, value);
    }
    case SYNAPSE_FIELD_I64: {
        int64_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIi64, field->name, value);
    }
    case SYNAPSE_FIELD_U64: {
        uint64_t value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%" PRIu64, field->name, value);
    }
    case SYNAPSE_FIELD_F32: {
        float value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%g", field->name, (double)value);
    }
    case SYNAPSE_FIELD_F64: {
        double value;
        memcpy(&value, base, sizeof(value));
        return snprintf(out, out_size, "%s=%g", field->name, value);
    }
    default:
        return snprintf(out, out_size, "%s=?", field->name);
    }
}

int synapse_topic_snprint(char *out, size_t out_size, uint16_t topic_id,
                          const void *payload, size_t payload_len)
{
    const synapse_topic_fields_t *fields = synapse_topic_fields_by_id(topic_id);
    size_t used = 0;

    if (fields == NULL || payload == NULL ||
        payload_len != (size_t)fields->payload_size) {
        return -1;
    }
    if (out_size > 0) {
        out[0] = '\0';
    }

    for (uint16_t i = 0; i < fields->field_count; ++i) {
        int written;

        if (i > 0) {
            written = snprintf(used < out_size ? out + used : NULL,
                               used < out_size ? out_size - used : 0, " ");
            if (written < 0) {
                return written;
            }
            used += (size_t)written;
        }

        written = synapse_field_snprint(used < out_size ? out + used : NULL,
                                        used < out_size ? out_size - used : 0,
                                        &fields->fields[i], payload);
        if (written < 0) {
            return written;
        }
        used += (size_t)written;
    }

    return (int)used;
}
