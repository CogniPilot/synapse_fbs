/*
 * Parse a possibly namespaced topic key expression such as
 * "cub1/synapse/v1/topic/inertial_sample/0". Leading and trailing slashes
 * are ignored. On success returns the catalog entry and writes the namespace
 * substring (start pointer into `key` and length, empty when absent) and the
 * instance segment (-1 when absent). Out parameters may be NULL. Instance
 * segments are 1 to 9 ASCII digits; this grammar is identical in the Rust,
 * Python, JavaScript, and C catalog helpers.
 */
static inline const synapse_topic_info_t *synapse_topic_parse_key(
    const char *key, const char **namespace_start, size_t *namespace_len,
    int32_t *instance) {
    if (key == NULL) {
        return NULL;
    }
    while (*key == '/') {
        ++key;
    }
    const char *end = key + strlen(key);
    while (end > key && end[-1] == '/') {
        --end;
    }

    static const char anchored[] = SYNAPSE_TOPIC_KEY_PREFIX "/";
    const size_t anchored_len = sizeof(anchored) - 1;

    /* Find the canonical prefix at a segment boundary. */
    const char *anchor = key;
    while ((size_t)(end - anchor) <= anchored_len ||
           strncmp(anchor, anchored, anchored_len) != 0) {
        const char *next = (const char *)memchr(anchor, '/', (size_t)(end - anchor));
        if (next == NULL) {
            return NULL;
        }
        anchor = next + 1;
    }

    const char *suffix = anchor + anchored_len;
    const char *suffix_end = (const char *)memchr(suffix, '/', (size_t)(end - suffix));
    size_t suffix_len =
        suffix_end == NULL ? (size_t)(end - suffix) : (size_t)(suffix_end - suffix);
    if (suffix_len == 0) {
        return NULL;
    }

    const synapse_topic_info_t *topic = NULL;
    for (size_t i = 0; i < synapse_topics_count; ++i) {
        if (strlen(synapse_topics[i].key_suffix) == suffix_len &&
            strncmp(synapse_topics[i].key_suffix, suffix, suffix_len) == 0) {
            topic = &synapse_topics[i];
            break;
        }
    }
    if (topic == NULL) {
        return NULL;
    }

    int32_t parsed_instance = -1;
    if (suffix_end != NULL) {
        const char *segment = suffix_end + 1;
        size_t segment_len = (size_t)(end - segment);
        if (segment_len == 0 || segment_len > 9) {
            return NULL;
        }
        int32_t value = 0;
        for (size_t i = 0; i < segment_len; ++i) {
            if (segment[i] < '0' || segment[i] > '9') {
                return NULL;
            }
            value = value * 10 + (segment[i] - '0');
        }
        parsed_instance = value;
    }

    if (namespace_start != NULL || namespace_len != NULL) {
        size_t length = (size_t)(anchor - key);
        while (length > 0 && key[length - 1] == '/') {
            --length;
        }
        if (namespace_start != NULL) {
            *namespace_start = key;
        }
        if (namespace_len != NULL) {
            *namespace_len = length;
        }
    }
    if (instance != NULL) {
        *instance = parsed_instance;
    }
    return topic;
}

static inline const synapse_topic_info_t *synapse_topic_by_key(const char *key) {
    if (key == NULL) {
        return NULL;
    }
    while (*key == '/') {
