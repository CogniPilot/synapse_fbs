export interface TopicInfo {
  readonly id: number;
  readonly name: string;
  readonly key: string;
  readonly rootTable: string;
  readonly payloadType: string | null;
  readonly payloadSize: number | null;
  readonly schemaFile: string;
  readonly wireType: string;
  readonly schemaHash: string;
  readonly fixedLayout: boolean;
  readonly multiInstance: boolean;
  readonly scope: string;
  readonly encoding: string;
  readonly description: string;
}

export interface CommandInfo {
  readonly id: number;
  readonly name: string;
  readonly key: string;
  readonly requestType: string;
  readonly requestSchemaHash: string;
  readonly replyType: string;
  readonly replySchemaHash: string;
  readonly requestEncoding: string;
  readonly requestSize: number | null;
  readonly replyEncoding: string;
  readonly replySize: number | null;
  readonly description: string;
}

export interface ParsedTopicKey {
  readonly namespace: string;
  readonly topic: TopicInfo;
  readonly instance: number | null;
}

export const cmdKeyPrefix: string;
export const metaKeyPrefix: string;
export const livelinessKeyPrefix: string;
export const schemaSetHash: string;

export const topicCatalog: readonly TopicInfo[];
export const commandCatalog: readonly CommandInfo[];

export function topicById(id: number): TopicInfo | undefined;
export function topicByName(name: string): TopicInfo | undefined;
export function topicByKey(key: string): TopicInfo | undefined;
export function parseKey(key: string): ParsedTopicKey | undefined;
export function keyForTopic(topic: number | string): string | undefined;
export function commandByName(name: string): CommandInfo | undefined;
