// Generated by xtask from fbs/types.fbs and root wrapper tables.
export const cmdKeyPrefix = {{ cmd_key_prefix|tojson }};
export const metaKeyPrefix = {{ meta_key_prefix|tojson }};
export const livelinessKeyPrefix = {{ liveliness_key_prefix|tojson }};
export const schemaSetHash = {{ schema_set_hash|tojson }};

const topics = [
{%- for topic in topics %}
  Object.freeze({
    id: {{ topic.id }},
    name: {{ topic.name|tojson }},
    key: {{ topic.key|tojson }},
    rootTable: {{ topic.root_table|tojson }},
    payloadType: {{ topic.payload_type|tojson }},
    payloadSize: {{ topic.payload_size|tojson }},
    schemaFile: {{ topic.schema_file|tojson }},
    wireType: {{ topic.wire_type|tojson }},
    schemaHash: {{ topic.schema_hash|tojson }},
    fixedLayout: {{ topic.fixed_layout|tojson }},
    multiInstance: {{ topic.multi_instance|tojson }},
    scope: {{ topic.scope|tojson }},
    encoding: {{ topic.encoding|tojson }},
    description: {{ topic.description|tojson }}
  }){% if not loop.last %},{% endif %}
{%- endfor %}
];

const commands = [
{%- for command in commands %}
  Object.freeze({
    id: {{ command.id }},
    name: {{ command.name|tojson }},
    key: {{ command.key|tojson }},
    requestType: {{ command.request_type|tojson }},
    requestSchemaHash: {{ command.request_schema_hash|tojson }},
    replyType: {{ command.reply_type|tojson }},
    replySchemaHash: {{ command.reply_schema_hash|tojson }},
    requestEncoding: {{ command.request_encoding|tojson }},
    requestSize: {{ command.request_size|tojson }},
    replyEncoding: {{ command.reply_encoding|tojson }},
    replySize: {{ command.reply_size|tojson }},
    description: {{ command.description|tojson }}
  }){% if not loop.last %},{% endif %}
{%- endfor %}
];

export const topicCatalog = Object.freeze(topics);
export const commandCatalog = Object.freeze(commands);

const byId = new Map(topicCatalog.map((topic) => [topic.id, topic]));
const byName = new Map(topicCatalog.map((topic) => [topic.name, topic]));
const byKey = new Map(topicCatalog.map((topic) => [topic.key, topic]));
const commandByNameMap = new Map(commandCatalog.map((command) => [command.name, command]));

function trimSlashes(key) {
  return String(key).replace(/^\/+/, '').replace(/\/+$/, '');
}

export function topicById(id) {
  return byId.get(Number(id));
}

export function topicByName(name) {
  return byName.get(String(name));
}

/**
 * Parse a possibly namespaced topic key expression such as `cub1/odom`,
 * `qualisys/cub1/external_pose`, or `cub1/imu/0`. The topic key is the last
 * segment, or the second-to-last when an instance segment follows; everything
 * before it is the deployment namespace, which may be empty or contain
 * multiple segments.
 * @param {string} key Key expression to parse.
 * @returns {ParsedTopicKey | undefined} Namespace, topic, and instance, or undefined.
 */
export function parseKey(key) {
  const trimmed = trimSlashes(key);
  if (trimmed.length === 0) {
    return undefined;
  }
  const lastSlash = trimmed.lastIndexOf('/');
  const rest = lastSlash < 0 ? '' : trimmed.slice(0, lastSlash);
  const last = trimmed.slice(lastSlash + 1);
  const direct = byKey.get(last);
  if (direct) {
    return { namespace: rest.replace(/\/+$/, ''), topic: direct, instance: null };
  }

  // Topic keys never consist solely of digits, so a trailing instance
  // segment is unambiguous. Instance segments are 1 to 9 ASCII digits; this
  // grammar is identical in the Rust, Python, JavaScript, and C catalog
  // helpers.
  if (!/^[0-9]{1,9}$/.test(last)) {
    return undefined;
  }
  const nameSlash = rest.lastIndexOf('/');
  const namespace = nameSlash < 0 ? '' : rest.slice(0, nameSlash).replace(/\/+$/, '');
  const topic = byKey.get(rest.slice(nameSlash + 1));
  if (!topic) {
    return undefined;
  }
  return { namespace, topic, instance: Number(last) };
}

export function topicByKey(key) {
  const normalized = String(key).replace(/^\/+/, '');
  const direct = byKey.get(normalized);
  if (direct) {
    return direct;
  }
  return parseKey(normalized)?.topic;
}

export function keyForTopic(topic) {
  const info = typeof topic === 'number'
    ? topicById(topic)
    : topicByName(topic) ?? topicByKey(topic);
  return info?.key;
}

export function commandByName(name) {
  return commandByNameMap.get(String(name));
}
